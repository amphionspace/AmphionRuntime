{
  "version": "v2.6",
  "description": "Shared frontend protected-span and post-TN repair rules. Add technical badcases here before changing runtime code.",
  "replacements": [
    {
      "name": "connector-hyphen-protect",
      "stages": ["pre_tn", "post_frontend"],
      "pattern": "(?<![A-Za-z0-9])(USB|Type)-([A-Za-z])(?![A-Za-z0-9])",
      "replacement": "$1 $2"
    },
    {
      "name": "connector-spoken-hyphen-repair",
      "stages": ["post_frontend"],
      "pattern": "(?<![A-Za-z0-9])(USB|Type)[杠减]([A-Za-z])(?![A-Za-z0-9])",
      "replacement": "$1 $2"
    },
    {
      "name": "chatgpt-split-repair",
      "stages": ["post_frontend"],
      "pattern": "(?<![A-Za-z0-9])chat\\s+g\\s*p\\s*t(?![A-Za-z0-9])",
      "replacement": "chatgpt"
    },
    {
      "name": "wifi-hyphen-protect",
      "stages": ["pre_tn", "post_frontend"],
      "pattern": "(?<![A-Za-z0-9])Wi-Fi(?![A-Za-z0-9])",
      "replacement": "WiFi"
    },
    {
      "name": "underscore-word-boundary",
      "stages": ["post_frontend"],
      "pattern": "\\bunderscore(?=[A-Za-z])",
      "replacement": "underscore "
    },
    {
      "name": "android-home-underscore-protect",
      "stages": ["pre_tn"],
      "pattern": "(?<![A-Za-z0-9])ANDROID_HOME(?![A-Za-z0-9])",
      "replacement": "ANDROID underscore HOME"
    }
  ]
}
