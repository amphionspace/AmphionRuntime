    <string name="app_name">Lits TTS Sample</string>
    <string name="sample_title">Dingqiao 纯 TTS Sample</string>
    <string name="sample_subtitle">页面只展示纯 TTS 业务流程：输入文本、选择语言、开始合成、SDK 直接播报、播放结果、保存 WAV。SDK 接口生命周期和回调处理都在后台完成。</string>

    <string name="label_input">合成文本</string>
    <string name="label_mode">语言模式</string>
    <string name="label_chunk_size">Chunk size</string>
    <string name="label_pcm_queue_capacity">PCM queue capacity</string>
    <string name="label_speed">Speed</string>
    <string name="label_result">运行结果</string>
    <string name="label_log">运行日志（自测）</string>

    <string name="hint_input">请输入要合成的文本</string>
    <string name="hint_chunk_size">留空使用模型默认值</string>
    <string name="hint_pcm_queue_capacity">默认 128</string>
    <string name="hint_speed">默认 1.0，范围 0.5~2.0</string>
    <string name="mode_mixed">zh-en</string>
    <string name="mode_en">en-US</string>
    <string name="mode_desc">纯数字在 zh-en 模式下按中文读，在 en-US 模式下按英文读；末尾句点作为标点，小数保留小数读法。</string>
    <string name="action_desc">“开始合成”生成音频；“SDK 直接播报”合成并播放；“Warmup”先运行一条短句。模型决定使用整句或流式合成，Chunk size 仅对流式模型生效。PCM queue capacity 调整播放缓冲容量，Speed 调整语速。</string>

