# --- macOS / IDE ---
.DS_Store
*.iml
.idea/
*.swp
*.swo

# --- Android / Gradle ---
.gradle/
local.properties
**/build/
.externalNativeBuild/
.cxx/

# --- iOS / Xcode ---
.swiftpm/
*.xcworkspace/xcuserdata/
DerivedData/
.build/

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/

# --- C++ / cmake ---
server/asr-service/build/
**/cmake-build-*/

# --- 编译产物（每次本地或 CI 重新构建） ---
android/AmphionRuntime/sdk/src/main/jniLibs/**/*.so
android/AmphionRuntime/sample/src/main/jniLibs/**/*.so
android/AmphionRuntime/sdk/maven-repo/
ios/AmphionRuntime/AmphionRuntime.xcframework/
ios/AmphionRuntime/AmphionRuntime.xcframework.zip
ios/AmphionRuntime/AmphionRuntime.xcframework.zip.sha256

# Sample app 模型资源（不入库）
android/AmphionRuntime/sample/src/main/assets/asr-models/
# WeText ITN fst 构建缓存（由 tools/asr/00_push_weitn_fsts.sh 产出）
tools/asr/weitn-fsts/
# 标点模型 tarball / 解压结果（由 tools/asr/00_push_punct_model.sh 产出）
tools/asr/punct-model/

# --- 上游 sherpa-onnx 在 submodule 路径下产生的构建工件 ---
# 这些目录在 third_party/sherpa-onnx 下被上游 build-android-*.sh 创建；
# 不通过 submodule 提交，submodule 自己有 .gitignore 管这些。
# 这里仍然兜一层防止误提交。
third_party/sherpa-onnx/build-*/
third_party/sherpa-onnx/build-android-*/
third_party/sherpa-onnx/build-ios/
third_party/sherpa-onnx/onnxruntime-*/

# --- 回归测试 wav 数据（外部分发，不入库） ---
shared/regression-set/audio/

# --- 大型模型/音频/分词器二进制（不入库） ---
# Demo 模型由 tools/asr/00_fetch_demo_model.sh 拉取到 tools/asr/demo-model/
# 自有模型由 tools/asr/00_push_my_model.sh 推到设备，本地目录由用户自管
*.onnx
*.wav
*.tar
*.tar.bz2
*.tar.gz
*.tgz
*.zip
bpe.model
bpe.vocab
# 但不要忘了：当 demo-model/ 目录里的 manifest.json / export_meta.json / tokens.txt / README.md
# 是文本元数据，依然入库，所以这里只忽略二进制后缀。

# --- dashboard 渲染产物（CI 生成） ---
shared/docs/dashboard/trends/reports/*.md
shared/docs/dashboard/trends/*.csv
!shared/docs/dashboard/trends/reports/.gitkeep
!shared/docs/dashboard/trends/.gitkeep
