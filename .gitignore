*-private.pem
.secure/
current_usb_device_sn.txt
tools/license/*.pem
tools/license/*.lic
asr/tools/license/*.pem
asr/tools/license/*.lic
tts/tools/license/*.pem
tts/tools/license/*.lic
**/amphion-license.lic
asr/android/keystore/
