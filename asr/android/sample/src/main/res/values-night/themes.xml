        <item name="colorPrimaryDark">@color/brand_accent_pressed</item>
        <item name="colorAccent">@color/brand_accent</item>

        <item name="colorControlNormal">@color/brand_text_muted</item>
        <item name="colorControlActivated">@color/brand_accent</item>
