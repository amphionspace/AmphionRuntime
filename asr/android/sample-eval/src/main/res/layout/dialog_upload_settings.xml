<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/eval_upload_settings_msg"
        android:textAppearance="@style/TextAppearance.Amphion.Status" />

    <EditText
        android:id="@+id/et_server_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/eval_upload_url_hint"
        android:inputType="textUri"
        android:maxLines="1" />

    <Button
        android:id="@+id/btn_use_official_server"
        style="?attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:minHeight="32dp"
        android:paddingHorizontal="8dp"
        android:text="@string/eval_upload_use_official"
        android:textAllCaps="false"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/et_bearer_token"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/eval_upload_token_hint"
        android:inputType="textPassword"
        android:maxLines="1" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/sw_auto_upload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/eval_upload_auto_label" />
</LinearLayout>
