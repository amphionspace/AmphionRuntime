<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_cream"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/enroll_title" />

    <TextView
        android:id="@+id/tv_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/enroll_hint"
        android:textColor="@color/brand_text_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.Amphion.Status" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_samples"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/enroll_empty"
        android:textColor="@color/brand_text_muted"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_registered_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/brand_text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_delete_voiceprint"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_button_recording"
        android:text="@string/enroll_delete_voiceprint"
        android:textColor="@color/brand_on_accent"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_import_model"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_button_primary"
        android:text="@string/menu_import_model"
        android:textColor="@color/brand_on_accent" />

    <Button
        android:id="@+id/btn_record"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_button_primary"
        android:text="@string/enroll_record"
        android:textColor="@color/brand_on_accent" />

    <Button
        android:id="@+id/btn_register"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_button_primary"
        android:enabled="false"
        android:text="@string/enroll_register"
        android:textColor="@color/brand_on_accent" />

</LinearLayout>
