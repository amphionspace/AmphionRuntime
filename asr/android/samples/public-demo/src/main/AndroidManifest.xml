<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 云端 ASR WebSocket 需要联网；ws:// 为明文，开放 cleartext 仅为演示，生产请用 wss://。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".AmphionApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.AmphionAsrSample">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HotwordsActivity"
            android:exported="false"
            android:label="@string/hotwords_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".SpeakerEnrollActivity"
            android:exported="false"
            android:label="@string/enroll_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".plate.PlateBatchEvalActivity"
            android:exported="true"
            android:label="@string/batch_eval_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".police_station.PoliceStationBatchEvalActivity"
            android:exported="true"
            android:label="@string/station_batch_eval_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".police_terms.PoliceTermsBatchEvalActivity"
            android:exported="true"
            android:label="@string/terms_batch_eval_title"
            android:parentActivityName=".MainActivity" />

    </application>

</manifest>
