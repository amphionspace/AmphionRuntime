{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "compatibleSdkVersion": "5.0.0(12)",
        "targetSdkVersion": "5.0.0(12)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "dingqiao_demo",
      "srcPath": "./samples/dingqiao-demo/entry"
    },
    {
      "name": "amphion_asr",
      "srcPath": "../../asr/harmony/sdk"
    },
    {
      "name": "amphion_police",
      "srcPath": "../../asr/harmony/sdk-police"
    },
    {
      "name": "amphion_dingqiao",
      "srcPath": "../../asr/harmony/sdk-dingqiao"
    },
    {
      "name": "sherpa_onnx",
      "srcPath": "../../third_party/sherpa-onnx/harmony-os/SherpaOnnxHar/sherpa_onnx"
    }
  ]
}
