+    // reuse it. thread_local keeps this lock-free and safe even if an engine is
+    // shared across threads (the JNI path) — each thread keeps its own cache.
+    // Behaviour is identical: RegexPattern::compile(pattern,0,...) then
+    // pattern->matcher() matches exactly like RegexMatcher(pattern,0,...).
+    static thread_local std::unordered_map<std::string, std::unique_ptr<icu::RegexPattern>> patternCache;
+    std::string patternKey;
+    pattern.toUTF8String(patternKey);
+    icu::RegexPattern* compiled = nullptr;
+    auto cacheIt = patternCache.find(patternKey);
+    if (cacheIt != patternCache.end()) {
+        compiled = cacheIt->second.get();
+    } else {
+        UParseError parseError;
+        UErrorCode compileStatus = U_ZERO_ERROR;
+        icu::RegexPattern* built = icu::RegexPattern::compile(pattern, 0, parseError, compileStatus);
+        if (U_SUCCESS(compileStatus) && built != nullptr) {
+            compiled = built;
+            patternCache.emplace(std::move(patternKey), std::unique_ptr<icu::RegexPattern>(built));
+        }
+    }
+    if (compiled == nullptr) {
         return input;
     }
+    std::unique_ptr<icu::RegexMatcher> matcherPtr(compiled->matcher(status));
