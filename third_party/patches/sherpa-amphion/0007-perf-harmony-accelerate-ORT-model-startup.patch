+class CreateOfflinePunctuationAsyncWorker : public Napi::AsyncWorker {
+ public:
+  CreateOfflinePunctuationAsyncWorker(
+      Napi::Env env, SherpaOnnxOfflinePunctuationConfig config,
+      Napi::Promise::Deferred deferred, void *mgr,
+      napi_ref resource_manager_ref)
+      : Napi::AsyncWorker(env, "CreateOfflinePunctuationAsyncWorker"),
+        config_(config),
+        deferred_(deferred),
+        mgr_(mgr),
+        resource_manager_ref_(resource_manager_ref) {}
+
+  ~CreateOfflinePunctuationAsyncWorker() override {
+    if (punctuation_ != nullptr) {
+      SherpaOnnxDestroyOfflinePunctuation(punctuation_);
+      punctuation_ = nullptr;
+    }
+    ReleaseResourceManager();
+    FreeOfflinePunctuationConfig(config_);
+  }
+
+  void Execute() override {
+    try {
+#if __OHOS__
+      if (mgr_ != nullptr) {
+        punctuation_ = SherpaOnnxCreateOfflinePunctuationOHOS(
+            &config_, static_cast<NativeResourceManager *>(mgr_));
+      } else {
+        punctuation_ = SherpaOnnxCreateOfflinePunctuation(&config_);
+      }
+#else
+      punctuation_ = SherpaOnnxCreateOfflinePunctuation(&config_);
+#endif
+    } catch (const std::exception &e) {
+      error_ = std::string("Failed to create offline punctuation: ") +
+               e.what();
+      return;
+    } catch (...) {
+      error_ =
+          "Failed to create offline punctuation: unknown native exception";
+      return;
+    }
+
+    if (punctuation_ == nullptr) {
+      error_ = "Failed to create offline punctuation: check the config";
+    }
+  }
+
+  void OnOK() override {
+    Napi::Env env = Env();
+    if (!error_.empty()) {
+      ReleaseResourceManager();
+      deferred_.Reject(Napi::Error::New(env, error_).Value());
+      return;
+    }
+
+    Napi::External<SherpaOnnxOfflinePunctuation> external =
+        Napi::External<SherpaOnnxOfflinePunctuation>::New(
+            env, const_cast<SherpaOnnxOfflinePunctuation *>(punctuation_),
+            [](Napi::Env /*env*/, SherpaOnnxOfflinePunctuation *punctuation) {
+              SherpaOnnxDestroyOfflinePunctuation(punctuation);
+            });
+    punctuation_ = nullptr;
+    ReleaseResourceManager();
+    deferred_.Resolve(external);
+  }
+
+  void OnError(const Napi::Error &error) override {
+    if (punctuation_ != nullptr) {
+      SherpaOnnxDestroyOfflinePunctuation(punctuation_);
+      punctuation_ = nullptr;
+    }
+    ReleaseResourceManager();
+    deferred_.Reject(error.Value());
+  }
+
+ private:
+  void ReleaseResourceManager() {
+#if __OHOS__
+    if (mgr_ != nullptr) {
+      OH_ResourceManager_ReleaseNativeResourceManager(
+          static_cast<NativeResourceManager *>(mgr_));
+      mgr_ = nullptr;
+    }
+    if (resource_manager_ref_ != nullptr) {
+      napi_delete_reference(Env(), resource_manager_ref_);
+      resource_manager_ref_ = nullptr;
+    }
+#endif
+  }
+
+ private:
+  SherpaOnnxOfflinePunctuationConfig config_;
+  Napi::Promise::Deferred deferred_;
+  void *mgr_ = nullptr;
+  napi_ref resource_manager_ref_ = nullptr;
+  const SherpaOnnxOfflinePunctuation *punctuation_ = nullptr;
+  std::string error_;
+};
+
+static Napi::Value CreateOfflinePunctuationAsyncWrapper(
+    const Napi::CallbackInfo &info) {
+  Napi::Env env = info.Env();
+#if __OHOS__
+  if (info.Length() < 1 || info.Length() > 2 || !info[0].IsObject()) {
+    Napi::TypeError::New(env,
+                         "Expected config and optional resource manager")
+        .ThrowAsJavaScriptException();
+    return env.Null();
+  }
+#else
+  if (info.Length() != 1 || !info[0].IsObject()) {
+    Napi::TypeError::New(env, "Expected config object")
+        .ThrowAsJavaScriptException();
+    return env.Null();
+  }
+#endif
+
+  SherpaOnnxOfflinePunctuationConfig config;
+  memset(&config, 0, sizeof(config));
+  config.model =
+      GetOfflinePunctuationModelConfig(info[0].As<Napi::Object>());
+
+  void *mgr = nullptr;
+  napi_ref resource_manager_ref = nullptr;
+#if __OHOS__
+  const bool use_resource_manager =
+      info.Length() == 2 && !info[1].IsUndefined() && !info[1].IsNull();
+  if (use_resource_manager) {
+    if (!info[1].IsObject()) {
+      FreeOfflinePunctuationConfig(config);
+      Napi::TypeError::New(env, "resource manager must be an object")
+          .ThrowAsJavaScriptException();
+      return env.Null();
+    }
+
+    mgr = OH_ResourceManager_InitNativeResourceManager(env, info[1]);
+    if (mgr == nullptr ||
+        napi_create_reference(env, info[1], 1, &resource_manager_ref) !=
+            napi_ok) {
+      if (mgr != nullptr) {
+        OH_ResourceManager_ReleaseNativeResourceManager(
+            static_cast<NativeResourceManager *>(mgr));
+      }
+      FreeOfflinePunctuationConfig(config);
+      Napi::Error::New(env, "Failed to retain the resource manager")
+          .ThrowAsJavaScriptException();
+      return env.Null();
+    }
+  }
+#endif
+
+  Napi::Promise::Deferred deferred = Napi::Promise::Deferred::New(env);
+  auto *worker = new CreateOfflinePunctuationAsyncWorker(
+      env, config, deferred, mgr, resource_manager_ref);
+  try {
+    worker->Queue();
+  } catch (...) {
+    delete worker;
+    throw;
+  }
+  return deferred.Promise();
+}
