 namespace sherpa_onnx {
 
+bool IsOrtModel(const std::string &model_path) {
+  return EndsWith(model_path, ".ort");
+}
+
+void ConfigureSessionOptionsForModel(const std::string &model_path,
+                                     bool use_model_bytes_directly,
+                                     Ort::SessionOptions *sess_opts) {
+  if (!IsOrtModel(model_path)) {
+    return;
+  }
+
+  // ORT files have already been optimized offline. Re-running graph
+  // optimization adds cold-start latency and cannot improve this graph.
+  sess_opts->SetGraphOptimizationLevel(
+      GraphOptimizationLevel::ORT_DISABLE_ALL);
+  sess_opts->AddConfigEntry("session.load_model_format", "ORT");
+
+  if (use_model_bytes_directly) {
+    sess_opts->AddConfigEntry("session.use_ort_model_bytes_directly", "1");
+    sess_opts->AddConfigEntry(
+        "session.use_ort_model_bytes_for_initializers", "1");
+  }
+}
+
