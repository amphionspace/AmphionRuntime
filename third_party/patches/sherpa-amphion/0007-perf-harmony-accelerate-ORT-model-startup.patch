+static constexpr int32_t kDefaultWarmupSamples = 12800;
+static constexpr int32_t kWarmupSampleRate = 16000;
+
+static void WarmUpOnlineRecognizer(
+    const SherpaOnnxOnlineRecognizer *recognizer, int32_t warmup_samples) {
+  if (warmup_samples <= 0) {
+    return;
+  }
+
+  const SherpaOnnxOnlineStream *raw_stream =
+      SherpaOnnxCreateOnlineStream(recognizer);
+  if (raw_stream == nullptr) {
+    return;
+  }
+
+  std::unique_ptr<const SherpaOnnxOnlineStream,
+                  decltype(&SherpaOnnxDestroyOnlineStream)>
+      stream(raw_stream, &SherpaOnnxDestroyOnlineStream);
+  std::vector<float> silence(static_cast<size_t>(warmup_samples), 0.0f);
+  SherpaOnnxOnlineStreamAcceptWaveform(stream.get(), kWarmupSampleRate,
+                                       silence.data(), warmup_samples);
+  while (SherpaOnnxIsOnlineStreamReady(recognizer, stream.get())) {
+    SherpaOnnxDecodeOnlineStream(recognizer, stream.get());
+  }
+  SherpaOnnxOnlineStreamReset(recognizer, stream.get());
+}
