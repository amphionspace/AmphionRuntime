+class CreateOnlineRecognizerAsyncWorker : public Napi::AsyncWorker {
+ public:
+  CreateOnlineRecognizerAsyncWorker(
+      Napi::Env env, SherpaOnnxOnlineRecognizerConfig config,
+      Napi::Promise::Deferred deferred, void *mgr,
+      napi_ref resource_manager_ref, int32_t warmup_samples)
+      : Napi::AsyncWorker(env, "CreateOnlineRecognizerAsyncWorker"),
+        config_(config),
+        deferred_(deferred),
+        mgr_(mgr),
+        resource_manager_ref_(resource_manager_ref),
+        warmup_samples_(warmup_samples) {}
+
+  ~CreateOnlineRecognizerAsyncWorker() override {
+    if (recognizer_ != nullptr) {
+      SherpaOnnxDestroyOnlineRecognizer(recognizer_);
+      recognizer_ = nullptr;
+    }
+    ReleaseResourceManager();
+    FreeOnlineRecognizerConfig(config_);
+  }
+
+  void Execute() override {
+    try {
+#if __OHOS__
+      if (mgr_ != nullptr) {
+        recognizer_ = SherpaOnnxCreateOnlineRecognizerOHOS(
+            &config_, static_cast<NativeResourceManager *>(mgr_));
+      } else {
+        recognizer_ = SherpaOnnxCreateOnlineRecognizer(&config_);
+      }
+#else
+      recognizer_ = SherpaOnnxCreateOnlineRecognizer(&config_);
+#endif
+    } catch (const std::exception &e) {
+      error_ = std::string("Failed to create online recognizer: ") + e.what();
+      return;
+    } catch (...) {
+      error_ = "Failed to create online recognizer: unknown native exception";
+      return;
+    }
+
+    if (recognizer_ == nullptr) {
+      error_ = "Failed to create online recognizer: check the config";
+      return;
+    }
+
+    // Match the SDK's one-time silence warmup before resolving. Warmup remains
+    // best-effort so a usable recognizer is not discarded if a model rejects
+    // the synthetic stream.
+    try {
+      WarmUpOnlineRecognizer(recognizer_, warmup_samples_);
+    } catch (...) {
+    }
+  }
+
+  void OnOK() override {
+    Napi::Env env = Env();
+    if (!error_.empty()) {
+      ReleaseResourceManager();
+      deferred_.Reject(Napi::Error::New(env, error_).Value());
+      return;
+    }
+
+    Napi::External<SherpaOnnxOnlineRecognizer> external =
+        Napi::External<SherpaOnnxOnlineRecognizer>::New(
+            env, const_cast<SherpaOnnxOnlineRecognizer *>(recognizer_),
+            [](Napi::Env /*env*/, SherpaOnnxOnlineRecognizer *recognizer) {
+              SherpaOnnxDestroyOnlineRecognizer(recognizer);
+            });
+    recognizer_ = nullptr;
+    ReleaseResourceManager();
+    deferred_.Resolve(external);
+  }
+
+  void OnError(const Napi::Error &error) override {
+    if (recognizer_ != nullptr) {
+      SherpaOnnxDestroyOnlineRecognizer(recognizer_);
+      recognizer_ = nullptr;
+    }
+    ReleaseResourceManager();
+    deferred_.Reject(error.Value());
+  }
+
+ private:
+  void ReleaseResourceManager() {
+#if __OHOS__
+    if (mgr_ != nullptr) {
+      OH_ResourceManager_ReleaseNativeResourceManager(
+          static_cast<NativeResourceManager *>(mgr_));
+      mgr_ = nullptr;
+    }
+    if (resource_manager_ref_ != nullptr) {
+      napi_delete_reference(Env(), resource_manager_ref_);
+      resource_manager_ref_ = nullptr;
+    }
+#endif
+  }
+
+ private:
+  SherpaOnnxOnlineRecognizerConfig config_;
+  Napi::Promise::Deferred deferred_;
+  void *mgr_ = nullptr;
+  napi_ref resource_manager_ref_ = nullptr;
+  int32_t warmup_samples_ = 0;
+  const SherpaOnnxOnlineRecognizer *recognizer_ = nullptr;
+  std::string error_;
+};
+
+static Napi::Value CreateOnlineRecognizerAsyncWrapper(
+    const Napi::CallbackInfo &info) {
+  Napi::Env env = info.Env();
