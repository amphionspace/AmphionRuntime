+#ifndef SHERPA_ONNX_HARMONY_ONLINE_RECOGNIZER_HANDLE_H_
+#define SHERPA_ONNX_HARMONY_ONLINE_RECOGNIZER_HANDLE_H_
+
+#include <atomic>
+#include <cstdint>
+
+#include "napi.h"  // NOLINT
+#include "sherpa-onnx/c-api/c-api.h"
+
+// Deterministic-release wrapper for a native online recognizer, mirroring
+// OnlineStreamHandle. Without it the recognizer's ~150+ MB of ORT session
+// memory is only reclaimed when the NAPI-wrapped External is garbage-collected
+// and its finalizer runs, so SpeechRecognizeSdk.unloadModel (which just drops
+// ArkTS references) could not actually free memory. Close() is idempotent, so an
+// explicit destroyOnlineRecognizer() and the later finalizer never double-free.
+class OnlineRecognizerHandle {
+ public:
+  explicit OnlineRecognizerHandle(const SherpaOnnxOnlineRecognizer *recognizer)
+      : recognizer_(recognizer) {
+    if (recognizer_ != nullptr) LiveCount().fetch_add(1);
+  }
+
+  ~OnlineRecognizerHandle() { Close(); }
+
+  const SherpaOnnxOnlineRecognizer *Get() const { return recognizer_; }
+
+  void Close() {
+    if (recognizer_ == nullptr) return;
+    SherpaOnnxDestroyOnlineRecognizer(recognizer_);
+    recognizer_ = nullptr;
+    LiveCount().fetch_sub(1);
+  }
+
+  static int64_t ActiveCount() { return LiveCount().load(); }
+
+ private:
+  static std::atomic<int64_t> &LiveCount() {
+    static std::atomic<int64_t> count{0};
+    return count;
+  }
+
+  const SherpaOnnxOnlineRecognizer *recognizer_;
+};
+
+inline Napi::External<OnlineRecognizerHandle> WrapOnlineRecognizer(
+    Napi::Env env, const SherpaOnnxOnlineRecognizer *recognizer) {
+  auto *handle = new OnlineRecognizerHandle(recognizer);
+  return Napi::External<OnlineRecognizerHandle>::New(
+      env, handle,
+      [](Napi::Env, OnlineRecognizerHandle *value) { delete value; });
+}
+
+inline OnlineRecognizerHandle *GetOnlineRecognizerHandle(
+    const Napi::CallbackInfo &info, size_t index) {
+  return info[index].As<Napi::External<OnlineRecognizerHandle>>().Data();
+}
+
+// Unwrap for the many recognizer methods; returns nullptr on a closed handle so
+// existing null checks at the call sites still fire.
+inline const SherpaOnnxOnlineRecognizer *GetOnlineRecognizer(
+    const Napi::CallbackInfo &info, size_t index) {
+  OnlineRecognizerHandle *handle = GetOnlineRecognizerHandle(info, index);
+  return handle == nullptr ? nullptr : handle->Get();
+}
+
+#endif  // SHERPA_ONNX_HARMONY_ONLINE_RECOGNIZER_HANDLE_H_
