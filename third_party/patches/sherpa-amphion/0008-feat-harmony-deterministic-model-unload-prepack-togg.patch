+#ifndef SHERPA_ONNX_HARMONY_OFFLINE_PUNCTUATION_HANDLE_H_
+#define SHERPA_ONNX_HARMONY_OFFLINE_PUNCTUATION_HANDLE_H_
+
+#include <atomic>
+#include <cstdint>
+
+#include "napi.h"  // NOLINT
+#include "sherpa-onnx/c-api/c-api.h"
+
+// Deterministic-release wrapper for the native offline punctuation model
+// (ct-transformer, ~70 MB), mirroring OnlineRecognizerHandle so
+// SpeechRecognizeSdk.unloadModel can actually free it instead of waiting for GC.
+// Close() is idempotent, so explicit destroy + finalizer never double-free.
+class OfflinePunctuationHandle {
+ public:
+  explicit OfflinePunctuationHandle(const SherpaOnnxOfflinePunctuation *punct)
+      : punct_(punct) {
+    if (punct_ != nullptr) LiveCount().fetch_add(1);
+  }
+
+  ~OfflinePunctuationHandle() { Close(); }
+
+  const SherpaOnnxOfflinePunctuation *Get() const { return punct_; }
+
+  void Close() {
+    if (punct_ == nullptr) return;
+    SherpaOnnxDestroyOfflinePunctuation(punct_);
+    punct_ = nullptr;
+    LiveCount().fetch_sub(1);
+  }
+
+  static int64_t ActiveCount() { return LiveCount().load(); }
+
+ private:
+  static std::atomic<int64_t> &LiveCount() {
+    static std::atomic<int64_t> count{0};
+    return count;
+  }
+
+  const SherpaOnnxOfflinePunctuation *punct_;
+};
+
+inline Napi::External<OfflinePunctuationHandle> WrapOfflinePunctuation(
+    Napi::Env env, const SherpaOnnxOfflinePunctuation *punct) {
+  auto *handle = new OfflinePunctuationHandle(punct);
+  return Napi::External<OfflinePunctuationHandle>::New(
+      env, handle,
+      [](Napi::Env, OfflinePunctuationHandle *value) { delete value; });
+}
+
+inline OfflinePunctuationHandle *GetOfflinePunctuationHandle(
+    const Napi::CallbackInfo &info, size_t index) {
+  return info[index].As<Napi::External<OfflinePunctuationHandle>>().Data();
+}
+
+inline const SherpaOnnxOfflinePunctuation *GetOfflinePunctuation(
+    const Napi::CallbackInfo &info, size_t index) {
+  OfflinePunctuationHandle *handle = GetOfflinePunctuationHandle(info, index);
+  return handle == nullptr ? nullptr : handle->Get();
+}
+
+#endif  // SHERPA_ONNX_HARMONY_OFFLINE_PUNCTUATION_HANDLE_H_
