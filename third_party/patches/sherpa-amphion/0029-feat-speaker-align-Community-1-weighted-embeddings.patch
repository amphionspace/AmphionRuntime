+const float *SherpaOnnxSpeakerEmbeddingExtractorComputeEmbeddingWeighted(
+    const SherpaOnnxSpeakerEmbeddingExtractor *p,
+    const SherpaOnnxOnlineStream *s, const float *weights, int32_t num_weights) {
+  if (!p || !s || !weights || num_weights <= 0) return nullptr;
+  std::vector<float> mask(weights, weights + num_weights);
+  std::vector<float> v = p->impl->ComputeWeighted(s->impl.get(), mask);
+  float *ans = new float[v.size()];
+  std::copy(v.begin(), v.end(), ans);
+  return ans;
+}
