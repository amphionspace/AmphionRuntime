+static Napi::Value SpeakerEmbeddingExtractorComputeEmbeddingWeightedAsyncWrapper(
+    const Napi::CallbackInfo &info) {
+  Napi::Env env = info.Env();
+  if (info.Length() != 3 || !info[0].IsExternal() ||
+      !info[1].IsExternal() || !info[2].IsTypedArray()) {
+    Napi::TypeError::New(env,
+        "Expected speaker extractor, stream, and Float32Array weights")
+        .ThrowAsJavaScriptException();
+    return env.Null();
+  }
+  auto *extractor_handle = GetSpeakerEmbeddingExtractorHandle(info, 0);
+  auto *stream_handle = GetOnlineStreamHandle(info, 1);
+  auto extractor = extractor_handle == nullptr ? nullptr : extractor_handle->Lease();
+  auto stream = stream_handle == nullptr ? nullptr : stream_handle->Lease();
+  if (extractor == nullptr || extractor->Get() == nullptr ||
+      stream == nullptr || stream->Get() == nullptr) {
+    Napi::Error::New(env, "Speaker embedding extractor or stream is closed")
+        .ThrowAsJavaScriptException();
+    return env.Null();
+  }
+  Napi::TypedArray input = info[2].As<Napi::TypedArray>();
+  if (input.TypedArrayType() != napi_float32_array) {
+    Napi::TypeError::New(env, "weights must be Float32Array")
+        .ThrowAsJavaScriptException();
+    return env.Null();
+  }
+  auto float_input = info[2].As<Napi::Float32Array>();
+  std::vector<float> weights(float_input.Data(),
+                             float_input.Data() + float_input.ElementLength());
+  Napi::Promise::Deferred deferred = Napi::Promise::Deferred::New(env);
+  auto *worker = new SpeakerEmbeddingExtractorComputeAsyncWorker(
+      env, std::move(extractor), std::move(stream), deferred,
+      std::move(weights));
+  try {
+    worker->Queue();
+  } catch (...) {
+    delete worker;
+    deferred.Reject(Napi::Error::New(env,
+        "Failed to queue weighted speaker embedding work").Value());
+    return deferred.Promise();
+  }
+  return deferred.Promise();
+}
