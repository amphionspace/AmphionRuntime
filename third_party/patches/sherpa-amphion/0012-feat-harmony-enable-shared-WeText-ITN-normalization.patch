diff --git a/harmony-os/SherpaOnnxHar/sherpa_onnx/src/main/cpp/wetext-itn-handle.h b/harmony-os/SherpaOnnxHar/sherpa_onnx/src/main/cpp/wetext-itn-handle.h
new file mode 100644
index 00000000..f98c8a2d
--- /dev/null
+++ b/harmony-os/SherpaOnnxHar/sherpa_onnx/src/main/cpp/wetext-itn-handle.h
@@ -0,0 +1,36 @@
+#ifndef SHERPA_ONNX_HARMONY_WETEXT_ITN_HANDLE_H_
+#define SHERPA_ONNX_HARMONY_WETEXT_ITN_HANDLE_H_
+
+#include "napi.h"  // NOLINT
+#include "sherpa-onnx/c-api/c-api.h"
+
+class WetextItnHandle {
+ public:
+  explicit WetextItnHandle(const SherpaOnnxWetextItn *itn) : itn_(itn) {}
+  ~WetextItnHandle() { Close(); }
+
+  const SherpaOnnxWetextItn *Get() const { return itn_; }
+
+  void Close() {
+    if (itn_ == nullptr) return;
+    SherpaOnnxDestroyWetextItn(itn_);
+    itn_ = nullptr;
+  }
+
+ private:
+  const SherpaOnnxWetextItn *itn_;
+};
+
+inline Napi::External<WetextItnHandle> WrapWetextItn(
+    Napi::Env env, const SherpaOnnxWetextItn *itn) {
+  auto *handle = new WetextItnHandle(itn);
+  return Napi::External<WetextItnHandle>::New(
+      env, handle, [](Napi::Env, WetextItnHandle *value) { delete value; });
+}
+
+inline WetextItnHandle *GetWetextItnHandle(const Napi::CallbackInfo &info,
+                                           size_t index) {
+  return info[index].As<Napi::External<WetextItnHandle>>().Data();
+}
+
+#endif  // SHERPA_ONNX_HARMONY_WETEXT_ITN_HANDLE_H_
diff --git a/harmony-os/SherpaOnnxHar/sherpa_onnx/src/main/cpp/wetext-itn.cc b/harmony-os/SherpaOnnxHar/sherpa_onnx/src/main/cpp/wetext-itn.cc
new file mode 100644
index 00000000..e1511968
--- /dev/null
+++ b/harmony-os/SherpaOnnxHar/sherpa_onnx/src/main/cpp/wetext-itn.cc
@@ -0,0 +1,84 @@
+#include <sstream>
+#include <string>
+
+#include "napi.h"  // NOLINT
+#include "sherpa-onnx/c-api/c-api.h"
+#include "wetext-itn-handle.h"  // NOLINT
+
+static Napi::External<WetextItnHandle> CreateWetextItnWrapper(
+    const Napi::CallbackInfo &info) {
+  Napi::Env env = info.Env();
+  if (info.Length() != 1 || !info[0].IsObject()) {
+    Napi::TypeError::New(env, "Expected one WeText ITN config object")
+        .ThrowAsJavaScriptException();
+    return {};
+  }
+  const Napi::Object config = info[0].As<Napi::Object>();
+  if (!config.Has("taggerFst") || !config.Get("taggerFst").IsString() ||
+      !config.Has("verbalizerFst") ||
+      !config.Get("verbalizerFst").IsString()) {
+    Napi::TypeError::New(env, "taggerFst and verbalizerFst must be strings")
+        .ThrowAsJavaScriptException();
+    return {};
+  }
+
+  const std::string tagger =
+      config.Get("taggerFst").As<Napi::String>().Utf8Value();
+  const std::string verbalizer =
+      config.Get("verbalizerFst").As<Napi::String>().Utf8Value();
+  const SherpaOnnxWetextItn *itn =
+      SherpaOnnxCreateWetextItn(tagger.c_str(), verbalizer.c_str());
+  if (itn == nullptr) {
+    Napi::Error::New(env, "Failed to create WeText ITN processor")
+        .ThrowAsJavaScriptException();
+    return {};
+  }
+  return WrapWetextItn(env, itn);
+}
+
+static Napi::String WetextItnNormalizeWrapper(
+    const Napi::CallbackInfo &info) {
+  Napi::Env env = info.Env();
+  if (info.Length() != 2 || !info[0].IsExternal() || !info[1].IsString()) {
+    Napi::TypeError::New(env, "Expected WeText ITN handle and text")
+        .ThrowAsJavaScriptException();
+    return {};
+  }
+  WetextItnHandle *handle = GetWetextItnHandle(info, 0);
+  if (handle == nullptr || handle->Get() == nullptr) {
+    Napi::Error::New(env, "WeText ITN processor is closed")
+        .ThrowAsJavaScriptException();
+    return {};
+  }
+  const std::string text = info[1].As<Napi::String>().Utf8Value();
+  const char *normalized =
+      SherpaOnnxWetextItnNormalize(handle->Get(), text.c_str());
+  if (normalized == nullptr) {
+    Napi::Error::New(env, "WeText ITN normalization failed")
+        .ThrowAsJavaScriptException();
+    return {};
+  }
+  const Napi::String result = Napi::String::New(env, normalized);
+  SherpaOnnxWetextItnFreeText(normalized);
+  return result;
+}
+
+static void DestroyWetextItnWrapper(const Napi::CallbackInfo &info) {
+  Napi::Env env = info.Env();
+  if (info.Length() != 1 || !info[0].IsExternal()) {
+    Napi::TypeError::New(env, "Expected one WeText ITN handle")
+        .ThrowAsJavaScriptException();
+    return;
+  }
+  WetextItnHandle *handle = GetWetextItnHandle(info, 0);
+  if (handle != nullptr) handle->Close();
+}
+
+void InitWetextItn(Napi::Env env, Napi::Object exports) {
+  exports.Set(Napi::String::New(env, "createWetextItn"),
+              Napi::Function::New(env, CreateWetextItnWrapper));
+  exports.Set(Napi::String::New(env, "wetextItnNormalize"),
+              Napi::Function::New(env, WetextItnNormalizeWrapper));
+  exports.Set(Napi::String::New(env, "destroyWetextItn"),
+              Napi::Function::New(env, DestroyWetextItnWrapper));
+}
diff --git a/harmony-os/SherpaOnnxHar/sherpa_onnx/src/main/ets/components/WetextItn.ets b/harmony-os/SherpaOnnxHar/sherpa_onnx/src/main/ets/components/WetextItn.ets
new file mode 100644
index 00000000..55b93c88
--- /dev/null
+++ b/harmony-os/SherpaOnnxHar/sherpa_onnx/src/main/ets/components/WetextItn.ets
@@ -0,0 +1,30 @@
+import {
+  createWetextItn,
+  destroyWetextItn,
+  wetextItnNormalize,
+} from 'libsherpa_onnx.so';
+
+export class WetextItnConfig {
+  public taggerFst: string = '';
+  public verbalizerFst: string = '';
+}
+
+export class WetextItn {
+  private handle: object;
+  private closed: boolean = false;
+
+  constructor(config: WetextItnConfig) {
+    this.handle = createWetextItn(config);
+  }
+
+  normalize(text: string): string {
+    if (this.closed) return text;
+    return wetextItnNormalize(this.handle, text);
+  }
+
+  close(): void {
+    if (this.closed) return;
+    destroyWetextItn(this.handle);
+    this.closed = true;
+  }
+}
