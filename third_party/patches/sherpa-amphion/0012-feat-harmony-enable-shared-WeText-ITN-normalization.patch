 }
 
+const SherpaOnnxWetextItn *SherpaOnnxCreateWetextItn(
+    const char *tagger_fst, const char *verbalizer_fst) {
+  if (tagger_fst == nullptr || verbalizer_fst == nullptr) return nullptr;
+  try {
+    auto *itn = new SherpaOnnxWetextItn;
+    itn->impl =
+        std::make_unique<wetext::Processor>(tagger_fst, verbalizer_fst);
+    return itn;
+  } catch (...) {
+    return nullptr;
+  }
+}
+
+void SherpaOnnxDestroyWetextItn(const SherpaOnnxWetextItn *itn) {
+  delete itn;
+}
+
+const char *SherpaOnnxWetextItnNormalize(const SherpaOnnxWetextItn *itn,
+                                        const char *text) {
+  if (itn == nullptr || text == nullptr) return nullptr;
+  try {
+    const std::string normalized = itn->impl->Normalize(text);
+    char *result = new char[normalized.size() + 1];
+    std::memcpy(result, normalized.c_str(), normalized.size() + 1);
+    return result;
+  } catch (...) {
+    return nullptr;
+  }
+}
+
+void SherpaOnnxWetextItnFreeText(const char *text) { delete[] text; }
+
 struct SherpaOnnxOnlinePunctuation {
   std::unique_ptr<sherpa_onnx::OnlinePunctuation> impl;
 };
