+++ b/harmony-os/SherpaOnnxHar/sherpa_onnx/src/main/cpp/streaming-asr.cc
@@ -1038,6 +1038,25 @@ static Napi::Number GetEndpointReasonWrapper(const Napi::CallbackInfo &info) {
   return Napi::Number::New(env, reason);
 }
 
+static Napi::Boolean CommitRule3SegmentWrapper(
+    const Napi::CallbackInfo &info) {
+  Napi::Env env = info.Env();
+  if (info.Length() != 2 || !info[0].IsExternal() ||
+      !info[1].IsExternal()) {
+    Napi::TypeError::New(env, "Expected recognizer and stream handles.")
+        .ThrowAsJavaScriptException();
+    return {};
+  }
+
+  const SherpaOnnxOnlineRecognizer *recognizer = GetOnlineRecognizer(info, 0);
+  const SherpaOnnxOnlineStream *stream = GetOnlineStream(info, 1);
+  if (stream == nullptr) return {};
+
+  int32_t committed =
+      SherpaOnnxOnlineStreamCommitRule3Segment(recognizer, stream);
+  return Napi::Boolean::New(env, committed != 0);
+}
+
 static Napi::External<SherpaOnnxDisplay> CreateDisplayWrapper(
     const Napi::CallbackInfo &info) {
   Napi::Env env = info.Env();
@@ -1152,6 +1171,8 @@ void InitStreamingAsr(Napi::Env env, Napi::Object exports) {
               Napi::Function::New(env, IsEndpointWrapper));
   exports.Set(Napi::String::New(env, "getEndpointReason"),
               Napi::Function::New(env, GetEndpointReasonWrapper));
+  exports.Set(Napi::String::New(env, "commitRule3Segment"),
+              Napi::Function::New(env, CommitRule3SegmentWrapper));
 
   exports.Set(Napi::String::New(env, "createDisplay"),
               Napi::Function::New(env, CreateDisplayWrapper));
