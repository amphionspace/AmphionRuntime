diff --git a/sherpa-onnx/csrc/online-transducer-greedy-search-decoder.cc b/sherpa-onnx/csrc/online-transducer-greedy-search-decoder.cc
index 27965a8b..48fe5fee 100644
--- a/sherpa-onnx/csrc/online-transducer-greedy-search-decoder.cc
+++ b/sherpa-onnx/csrc/online-transducer-greedy-search-decoder.cc
@@ -171,4 +171,19 @@ void OnlineTransducerGreedySearchDecoder::Decode(
   }
 }
 
+bool OnlineTransducerGreedySearchDecoder::CommitRule3Segment(
+    OnlineTransducerDecoderResult *result, int32_t context_size) const {
+  if (result == nullptr || context_size <= 0 ||
+      static_cast<int32_t>(result->tokens.size()) <= context_size) {
+    return false;
+  }
+
+  OnlineTransducerDecoderResult checkpoint;
+  checkpoint.tokens.assign(result->tokens.end() - context_size,
+                           result->tokens.end());
+  checkpoint.decoder_out = std::move(result->decoder_out);
+  *result = std::move(checkpoint);
+  return true;
+}
+
 }  // namespace sherpa_onnx
