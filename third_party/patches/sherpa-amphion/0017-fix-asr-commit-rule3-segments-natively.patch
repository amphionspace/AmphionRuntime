diff --git a/sherpa-onnx/csrc/online-transducer-decoder.h b/sherpa-onnx/csrc/online-transducer-decoder.h
index 922cd61b..8324444a 100644
--- a/sherpa-onnx/csrc/online-transducer-decoder.h
+++ b/sherpa-onnx/csrc/online-transducer-decoder.h
@@ -104,6 +104,16 @@ class OnlineTransducerDecoder {
 
   // used for endpointing. We need to keep decoder_out after reset
   virtual void UpdateDecoderOut(OnlineTransducerDecoderResult * /*result*/) {}
+
+  /** Freeze the published path at a Rule3 endpoint and retain only the
+   * decoder state required to continue on the next segment.
+   *
+   * The encoder state is owned by OnlineStream and is deliberately untouched.
+   * Implementations must leave tokens/timestamps/scores empty from the public
+   * segment point of view and keep their internal state bounded.
+   */
+  virtual bool CommitRule3Segment(OnlineTransducerDecoderResult *result,
+                                  int32_t context_size) const = 0;
 };
 
