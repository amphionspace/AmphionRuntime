diff --git a/sherpa-onnx/csrc/online-transducer-modified-beam-search-decoder.cc b/sherpa-onnx/csrc/online-transducer-modified-beam-search-decoder.cc
index f33f157f..2cc84d11 100644
--- a/sherpa-onnx/csrc/online-transducer-modified-beam-search-decoder.cc
+++ b/sherpa-onnx/csrc/online-transducer-modified-beam-search-decoder.cc
@@ -268,4 +268,30 @@ void OnlineTransducerModifiedBeamSearchDecoder::UpdateDecoderOut(
   result->decoder_out = model_->RunDecoder(std::move(decoder_input));
 }
 
+bool OnlineTransducerModifiedBeamSearchDecoder::CommitRule3Segment(
+    OnlineTransducerDecoderResult *result, int32_t context_size) const {
+  if (result == nullptr || context_size <= 0 || result->hyps.Size() == 0) {
+    return false;
+  }
+
+  auto best = result->hyps.GetMostProbable(true);
+  if (static_cast<int32_t>(best.ys.size()) <= context_size) {
+    return false;
+  }
+
+  best.ys.erase(best.ys.begin(), best.ys.end() - context_size);
+  best.timestamps.clear();
+  best.ys_probs.clear();
+  best.lm_probs.clear();
+  best.context_scores.clear();
+  best.cur_scored_pos = 0;
+  best.num_trailing_blanks = 0;
+
+  OnlineTransducerDecoderResult checkpoint;
+  checkpoint.tokens = best.ys;
+  checkpoint.hyps = Hypotheses({std::move(best)});
+  *result = std::move(checkpoint);
+  return true;
+}
+
 }  // namespace sherpa_onnx
