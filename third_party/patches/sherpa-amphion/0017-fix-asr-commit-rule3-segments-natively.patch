@@ -440,6 +440,27 @@ class OnlineRecognizerTransducerImpl : public OnlineRecognizerImpl {
     s->Reset();
   }
 
+  bool CommitRule3Segment(OnlineStream *s) const override {
+    if (GetEndpointReason(s) != EndpointReason::kRule3) {
+      return false;
+    }
+
+    auto published = s->GetResult();
+    decoder_->StripLeadingBlanks(&published);
+    if (published.tokens.empty()) {
+      return false;
+    }
+
+    if (!decoder_->CommitRule3Segment(&s->GetResult(),
+                                      model_->ContextSize())) {
+      return false;
+    }
+
+    s->GetCurrentSegment() += 1;
+    s->Reset();
+    return true;
+  }
+
  private:
   void InitHotwords() {
     // each line in hotwords_file contains space-separated words
