--- /dev/null
+++ b/sherpa-onnx/csrc/online-transducer-rule3-checkpoint-test.cc
@@ -0,0 +1,88 @@
+// sherpa-onnx/csrc/online-transducer-rule3-checkpoint-test.cc
+
+#include "sherpa-onnx/csrc/online-transducer-greedy-search-decoder.h"
+#include "sherpa-onnx/csrc/online-transducer-modified-beam-search-decoder.h"
+
+#include <vector>
+
+#include "gtest/gtest.h"
+
+namespace sherpa_onnx {
+
+TEST(OnlineTransducerRule3Checkpoint, GreedyKeepsBoundedDecoderContext) {
+  OnlineTransducerGreedySearchDecoder decoder(nullptr, -1, 0, 1);
+  OnlineTransducerDecoderResult result;
+  result.tokens = {-1, 0, 10, 11, 12};
+  result.timestamps = {2, 4, 6};
+  result.ys_probs = {-0.1, -0.2, -0.3};
+  result.frame_offset = 100;
+  result.num_trailing_blanks = 7;
+
+  ASSERT_TRUE(decoder.CommitRule3Segment(&result, 2));
+  EXPECT_EQ(result.tokens, (std::vector<int64_t>{11, 12}));
+  EXPECT_TRUE(result.timestamps.empty());
+  EXPECT_TRUE(result.ys_probs.empty());
+  EXPECT_EQ(result.frame_offset, 0);
+  EXPECT_EQ(result.num_trailing_blanks, 0);
+  EXPECT_FALSE(static_cast<bool>(result.decoder_out));
+
+  result.tokens.push_back(13);
+  result.timestamps.push_back(1);
+  result.ys_probs.push_back(-0.4);
+  EXPECT_EQ(result.tokens.size() - 2, result.timestamps.size());
+  EXPECT_EQ(result.tokens.size() - 2, result.ys_probs.size());
+}
+
+TEST(OnlineTransducerRule3Checkpoint, ModifiedBeamFreezesPublishedBestPath) {
+  OnlineTransducerModifiedBeamSearchDecoder decoder(
+      nullptr, nullptr, 8, 0, false, -1, 0, 1);
+  OnlineTransducerDecoderResult result;
+
+  Hypothesis best({-1, 0, 10, 11, 12}, 10);
+  best.timestamps = {2, 4, 6};
+  best.ys_probs = {-0.1, -0.2, -0.3};
+  best.lm_probs = {-1.1, -1.2, -1.3};
+  best.context_scores = {1.1, 1.2, 1.3};
+  best.cur_scored_pos = 3;
+  best.num_trailing_blanks = 7;
+  Hypothesis alternate({-1, 0, 20, 11, 12}, 1);
+  result.hyps.Add(std::move(best));
+  result.hyps.Add(std::move(alternate));
+  result.frame_offset = 100;
+
+  ASSERT_TRUE(decoder.CommitRule3Segment(&result, 2));
+  ASSERT_EQ(result.hyps.Size(), 1);
+  auto frozen = result.hyps.GetMostProbable(true);
+  EXPECT_EQ(frozen.ys, (std::vector<int64_t>{11, 12}));
+  EXPECT_TRUE(frozen.timestamps.empty());
+  EXPECT_TRUE(frozen.ys_probs.empty());
+  EXPECT_TRUE(frozen.lm_probs.empty());
+  EXPECT_TRUE(frozen.context_scores.empty());
+  EXPECT_EQ(frozen.cur_scored_pos, 0);
+  EXPECT_EQ(frozen.num_trailing_blanks, 0);
+  EXPECT_EQ(result.tokens, frozen.ys);
+  EXPECT_EQ(result.frame_offset, 0);
+  EXPECT_FALSE(static_cast<bool>(result.decoder_out));
+
+  auto &continued = result.hyps.begin()->second;
+  continued.ys.push_back(13);
+  continued.timestamps.push_back(1);
+  continued.ys_probs.push_back(-0.4);
+  continued.lm_probs.push_back(-1.4);
+  continued.context_scores.push_back(1.4);
+  EXPECT_EQ(continued.ys.size() - 2, continued.timestamps.size());
+  EXPECT_EQ(continued.ys.size() - 2, continued.ys_probs.size());
+  EXPECT_EQ(continued.ys.size() - 2, continued.lm_probs.size());
+  EXPECT_EQ(continued.ys.size() - 2, continued.context_scores.size());
+}
+
+TEST(OnlineTransducerRule3Checkpoint, RejectsEmptyPublishedResult) {
+  OnlineTransducerGreedySearchDecoder greedy(nullptr, -1, 0, 1);
+  OnlineTransducerDecoderResult result;
+  result.tokens = {-1, 0};
+
+  EXPECT_FALSE(greedy.CommitRule3Segment(&result, 2));
+  EXPECT_EQ(result.tokens, (std::vector<int64_t>{-1, 0}));
+}
+
+}  // namespace sherpa_onnx
