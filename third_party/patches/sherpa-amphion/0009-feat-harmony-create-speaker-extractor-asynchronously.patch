+#ifndef SHERPA_ONNX_HARMONY_SPEAKER_EMBEDDING_EXTRACTOR_HANDLE_H_
+#define SHERPA_ONNX_HARMONY_SPEAKER_EMBEDDING_EXTRACTOR_HANDLE_H_
+
+#include "napi.h"  // NOLINT
+#include "sherpa-onnx/c-api/c-api.h"
+
+class SpeakerEmbeddingExtractorHandle {
+ public:
+  explicit SpeakerEmbeddingExtractorHandle(
+      const SherpaOnnxSpeakerEmbeddingExtractor *extractor)
+      : extractor_(extractor) {}
+
+  ~SpeakerEmbeddingExtractorHandle() { Close(); }
+
+  const SherpaOnnxSpeakerEmbeddingExtractor *Get() const { return extractor_; }
+
+  void Close() {
+    if (extractor_ == nullptr) return;
+    SherpaOnnxDestroySpeakerEmbeddingExtractor(extractor_);
+    extractor_ = nullptr;
+  }
+
+ private:
+  const SherpaOnnxSpeakerEmbeddingExtractor *extractor_;
+};
+
+inline Napi::External<SpeakerEmbeddingExtractorHandle>
+WrapSpeakerEmbeddingExtractor(
+    Napi::Env env, const SherpaOnnxSpeakerEmbeddingExtractor *extractor) {
+  auto *handle = new SpeakerEmbeddingExtractorHandle(extractor);
+  return Napi::External<SpeakerEmbeddingExtractorHandle>::New(
+      env, handle,
+      [](Napi::Env, SpeakerEmbeddingExtractorHandle *value) { delete value; });
+}
+
+inline SpeakerEmbeddingExtractorHandle *GetSpeakerEmbeddingExtractorHandle(
+    const Napi::CallbackInfo &info, size_t index) {
+  return info[index]
+      .As<Napi::External<SpeakerEmbeddingExtractorHandle>>()
+      .Data();
+}
+
+inline const SherpaOnnxSpeakerEmbeddingExtractor *GetSpeakerEmbeddingExtractor(
+    const Napi::CallbackInfo &info, size_t index) {
+  SpeakerEmbeddingExtractorHandle *handle =
+      GetSpeakerEmbeddingExtractorHandle(info, index);
+  return handle == nullptr ? nullptr : handle->Get();
+}
+
+#endif  // SHERPA_ONNX_HARMONY_SPEAKER_EMBEDDING_EXTRACTOR_HANDLE_H_
