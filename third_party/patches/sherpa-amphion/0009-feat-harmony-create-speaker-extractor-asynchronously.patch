   constructor(config: SpeakerEmbeddingExtractorConfig, mgr?: object) {
-    this.handle = createSpeakerEmbeddingExtractor(config, mgr);
+    const pendingHandle = SpeakerEmbeddingExtractor.pendingAsyncHandle;
+    SpeakerEmbeddingExtractor.pendingAsyncHandle = undefined;
+    this.handle = pendingHandle === undefined ? createSpeakerEmbeddingExtractor(config, mgr) : pendingHandle;
     this.config = config;
     this.dim = speakerEmbeddingExtractorDim(this.handle);
   }
 
+  static async createAsync(config: SpeakerEmbeddingExtractorConfig, mgr?: object,
+    warmupSamples: number = SPEAKER_SAMPLE_RATE_HZ): Promise<SpeakerEmbeddingExtractor> {
+    const handle: object = await createSpeakerEmbeddingExtractorAsync(config, mgr, warmupSamples);
+    // ArkTS has no allocation-without-constructor primitive. Transfer the opaque native handle via
+    // private state so the public constructor never accepts caller-controlled native pointers.
+    SpeakerEmbeddingExtractor.pendingAsyncHandle = handle;
+    try {
+      return new SpeakerEmbeddingExtractor(config);
+    } finally {
+      if (SpeakerEmbeddingExtractor.pendingAsyncHandle === handle) {
+        SpeakerEmbeddingExtractor.pendingAsyncHandle = undefined;
