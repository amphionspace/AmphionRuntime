+    Napi::TypeError::New(env, "Expected one speaker extractor handle")
+        .ThrowAsJavaScriptException();
+    return;
+  }
+  SpeakerEmbeddingExtractorHandle *handle =
+      GetSpeakerEmbeddingExtractorHandle(info, 0);
+  if (handle != nullptr) handle->Close();
+}
