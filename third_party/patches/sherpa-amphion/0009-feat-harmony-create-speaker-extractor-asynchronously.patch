+
+static void WarmUpSpeakerEmbeddingExtractor(
+    const SherpaOnnxSpeakerEmbeddingExtractor *extractor,
+    int32_t warmup_samples) {
+  if (extractor == nullptr || warmup_samples <= 0) return;
+  const SherpaOnnxOnlineStream *raw_stream =
+      SherpaOnnxSpeakerEmbeddingExtractorCreateStream(extractor);
+  if (raw_stream == nullptr) return;
+
+  std::unique_ptr<const SherpaOnnxOnlineStream,
+                  decltype(&SherpaOnnxDestroyOnlineStream)>
+      stream(raw_stream, &SherpaOnnxDestroyOnlineStream);
+  std::vector<float> silence(static_cast<size_t>(warmup_samples), 0.0f);
+  SherpaOnnxOnlineStreamAcceptWaveform(stream.get(), 16000, silence.data(),
+                                       warmup_samples);
+  const float *embedding =
+      SherpaOnnxSpeakerEmbeddingExtractorComputeEmbedding(extractor,
+                                                          stream.get());
+  if (embedding != nullptr) {
+    SherpaOnnxSpeakerEmbeddingExtractorDestroyEmbedding(embedding);
+  }
+}
+
+class CreateSpeakerEmbeddingExtractorAsyncWorker : public Napi::AsyncWorker {
+ public:
+  CreateSpeakerEmbeddingExtractorAsyncWorker(
+      Napi::Env env, SherpaOnnxSpeakerEmbeddingExtractorConfig config,
+      Napi::Promise::Deferred deferred, void *mgr,
+      napi_ref resource_manager_ref, int32_t warmup_samples)
+      : Napi::AsyncWorker(env,
+                          "CreateSpeakerEmbeddingExtractorAsyncWorker"),
+        config_(config),
+        deferred_(deferred),
+        mgr_(mgr),
+        resource_manager_ref_(resource_manager_ref),
+        warmup_samples_(warmup_samples) {}
+
+  ~CreateSpeakerEmbeddingExtractorAsyncWorker() override {
+    if (extractor_ != nullptr) {
+      SherpaOnnxDestroySpeakerEmbeddingExtractor(extractor_);
+      extractor_ = nullptr;
+    }
+    ReleaseResourceManager();
+    FreeSpeakerEmbeddingExtractorConfig(config_);
+  }
+
+  void Execute() override {
+    try {
+#if __OHOS__
+      if (mgr_ != nullptr) {
+        extractor_ = SherpaOnnxCreateSpeakerEmbeddingExtractorOHOS(
+            &config_, static_cast<NativeResourceManager *>(mgr_));
+      } else {
+        extractor_ = SherpaOnnxCreateSpeakerEmbeddingExtractor(&config_);
+      }
+#else
+      extractor_ = SherpaOnnxCreateSpeakerEmbeddingExtractor(&config_);
+#endif
+    } catch (const std::exception &e) {
+      error_ = std::string("Failed to create speaker embedding extractor: ") +
+               e.what();
+      return;
+    } catch (...) {
+      error_ = "Failed to create speaker embedding extractor: unknown native "
+               "exception";
+      return;
+    }
+
+    if (extractor_ == nullptr) {
+      error_ =
+          "Failed to create speaker embedding extractor: check the config";
+      return;
+    }
+
+    try {
+      WarmUpSpeakerEmbeddingExtractor(extractor_, warmup_samples_);
+    } catch (...) {
+      // Warmup is best-effort; a valid extractor remains usable.
+    }
+  }
+
+  void OnOK() override {
+    Napi::Env env = Env();
+    if (!error_.empty()) {
+      ReleaseResourceManager();
+      deferred_.Reject(Napi::Error::New(env, error_).Value());
+      return;
+    }
+
+    Napi::External<SherpaOnnxSpeakerEmbeddingExtractor> external =
+        WrapSpeakerEmbeddingExtractor(env, extractor_);
+    extractor_ = nullptr;
+    ReleaseResourceManager();
+    deferred_.Resolve(external);
+  }
+
+  void OnError(const Napi::Error &error) override {
+    if (extractor_ != nullptr) {
+      SherpaOnnxDestroySpeakerEmbeddingExtractor(extractor_);
+      extractor_ = nullptr;
+    }
+    ReleaseResourceManager();
+    deferred_.Reject(error.Value());
+  }
+
+ private:
+  void ReleaseResourceManager() {
+#if __OHOS__
+    if (mgr_ != nullptr) {
+      OH_ResourceManager_ReleaseNativeResourceManager(
+          static_cast<NativeResourceManager *>(mgr_));
+      mgr_ = nullptr;
+    }
+    if (resource_manager_ref_ != nullptr) {
+      napi_delete_reference(Env(), resource_manager_ref_);
+      resource_manager_ref_ = nullptr;
+    }
+#endif
+  }
+
+ private:
+  SherpaOnnxSpeakerEmbeddingExtractorConfig config_;
+  Napi::Promise::Deferred deferred_;
+  void *mgr_ = nullptr;
+  napi_ref resource_manager_ref_ = nullptr;
+  int32_t warmup_samples_ = 0;
+  const SherpaOnnxSpeakerEmbeddingExtractor *extractor_ = nullptr;
+  std::string error_;
+};
+
+static Napi::Value CreateSpeakerEmbeddingExtractorAsyncWrapper(
+    const Napi::CallbackInfo &info) {
+  Napi::Env env = info.Env();
+#if __OHOS__
+  if (info.Length() < 1 || info.Length() > 3 || !info[0].IsObject()) {
+    Napi::TypeError::New(
+        env, "Expected config, optional resource manager, and warmup samples")
+        .ThrowAsJavaScriptException();
+    return env.Null();
+  }
+#else
+  if (info.Length() < 1 || info.Length() > 2 || !info[0].IsObject()) {
+    Napi::TypeError::New(env, "Expected config and optional warmup samples")
+        .ThrowAsJavaScriptException();
+    return env.Null();
+  }
+#endif
+
+  int32_t warmup_samples = 16000;
+#if __OHOS__
+  if (info.Length() == 3 && !info[2].IsUndefined()) {
+    if (!info[2].IsNumber()) {
+      Napi::TypeError::New(env, "warmup samples must be a number")
+          .ThrowAsJavaScriptException();
+      return env.Null();
+    }
+    warmup_samples = info[2].As<Napi::Number>().Int32Value();
+  }
+#else
+  if (info.Length() == 2 && !info[1].IsUndefined()) {
+    if (!info[1].IsNumber()) {
+      Napi::TypeError::New(env, "warmup samples must be a number")
+          .ThrowAsJavaScriptException();
+      return env.Null();
+    }
+    warmup_samples = info[1].As<Napi::Number>().Int32Value();
+  }
+#endif
+
+  SherpaOnnxSpeakerEmbeddingExtractorConfig config =
+      GetSpeakerEmbeddingExtractorConfig(info[0].As<Napi::Object>());
+  void *mgr = nullptr;
+  napi_ref resource_manager_ref = nullptr;
+#if __OHOS__
+  const bool use_resource_manager =
+      info.Length() >= 2 && !info[1].IsUndefined() && !info[1].IsNull();
+  if (use_resource_manager) {
+    if (!info[1].IsObject()) {
+      FreeSpeakerEmbeddingExtractorConfig(config);
+      Napi::TypeError::New(env, "resource manager must be an object")
+          .ThrowAsJavaScriptException();
+      return env.Null();
+    }
+    mgr = OH_ResourceManager_InitNativeResourceManager(env, info[1]);
+    if (mgr == nullptr ||
+        napi_create_reference(env, info[1], 1, &resource_manager_ref) !=
+            napi_ok) {
+      if (mgr != nullptr) {
+        OH_ResourceManager_ReleaseNativeResourceManager(
+            static_cast<NativeResourceManager *>(mgr));
+      }
+      FreeSpeakerEmbeddingExtractorConfig(config);
+      Napi::Error::New(env, "Failed to retain the resource manager")
+          .ThrowAsJavaScriptException();
+      return env.Null();
+    }
+  }
+#endif
+
+  Napi::Promise::Deferred deferred = Napi::Promise::Deferred::New(env);
+  auto *worker = new CreateSpeakerEmbeddingExtractorAsyncWorker(
+      env, config, deferred, mgr, resource_manager_ref, warmup_samples);
+  try {
+    worker->Queue();
+  } catch (...) {
+    delete worker;
+    throw;
+  }
+  return deferred.Promise();
 }
 
