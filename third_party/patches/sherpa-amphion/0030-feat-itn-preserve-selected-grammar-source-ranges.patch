diff --git a/sherpa-onnx/c-api/c-api.cc b/sherpa-onnx/c-api/c-api.cc
index 9211f425..522b7fef 100644
--- a/sherpa-onnx/c-api/c-api.cc
+++ b/sherpa-onnx/c-api/c-api.cc
@@ -2858,6 +2858,38 @@ const char *SherpaOnnxWetextItnNormalize(const SherpaOnnxWetextItn *itn,
   }
 }
 
+static size_t WetextUtf16Offset(const std::string& text, size_t byte_offset) {
+  size_t result = 0;
+  for (size_t i = 0; i < byte_offset; ++i) {
+    const auto c = static_cast<unsigned char>(text[i]);
+    if ((c & 0xc0) != 0x80) result += c >= 0xf0 ? 2 : 1;
+  }
+  return result;
+}
+
+const char *SherpaOnnxWetextItnNormalizeWithAlignment(
+    const SherpaOnnxWetextItn *itn, const char *text) {
+  if (itn == nullptr || text == nullptr) return nullptr;
+  try {
+    const std::string source(text);
+    const auto normalized = itn->impl->NormalizeWithAlignment(source);
+    auto spans = nlohmann::json::array();
+    for (const auto& span : normalized.spans) {
+      spans.push_back({
+          {"sourceBegin", WetextUtf16Offset(source, span.source_begin)},
+          {"sourceEnd", WetextUtf16Offset(source, span.source_end)},
+          {"textBegin", WetextUtf16Offset(normalized.text, span.text_begin)},
+          {"textEnd", WetextUtf16Offset(normalized.text, span.text_end)}});
+    }
+    const std::string json = nlohmann::json{{"text", normalized.text}, {"spans", spans}}.dump();
+    char *result = new char[json.size() + 1];
+    std::memcpy(result, json.c_str(), json.size() + 1);
+    return result;
+  } catch (...) {
+    return nullptr;
+  }
+}
+
 void SherpaOnnxWetextItnFreeText(const char *text) { delete[] text; }
 
