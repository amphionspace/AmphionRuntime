   public verbalizerFst: string = '';
@@ -22,6 +35,11 @@ export class WetextItn {
     return wetextItnNormalize(this.handle, text);
   }
 
+  normalizeWithAlignment(text: string): WetextItnResult {
+    if (this.closed) return { text, spans: [] };
