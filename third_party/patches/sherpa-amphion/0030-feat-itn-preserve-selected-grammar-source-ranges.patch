diff --git a/sherpa-onnx/c-api/c-api.h b/sherpa-onnx/c-api/c-api.h
index 63797a97..30d140cd 100644
--- a/sherpa-onnx/c-api/c-api.h
+++ b/sherpa-onnx/c-api/c-api.h
@@ -3633,6 +3633,12 @@ SHERPA_ONNX_API void SherpaOnnxDestroyWetextItn(
 SHERPA_ONNX_API const char *SherpaOnnxWetextItnNormalize(
     const SherpaOnnxWetextItn *itn, const char *text);
 
+/** JSON {text, spans:[{sourceBegin,sourceEnd,textBegin,textEnd}]}. Offsets are
+ * UTF-16 code units into the original input and normalized text, respectively.
+ * Empty spans mean provenance is unavailable. Free with WetextItnFreeText. */
+SHERPA_ONNX_API const char *SherpaOnnxWetextItnNormalizeWithAlignment(
+    const SherpaOnnxWetextItn *itn, const char *text);
+
 SHERPA_ONNX_API void SherpaOnnxWetextItnFreeText(const char *text);
 
 /**
diff --git a/sherpa-onnx/csrc/wetext/processor/wetext_processor.cc b/sherpa-onnx/csrc/wetext/processor/wetext_processor.cc
index 5a30c77a..2bf54a1f 100644
--- a/sherpa-onnx/csrc/wetext/processor/wetext_processor.cc
+++ b/sherpa-onnx/csrc/wetext/processor/wetext_processor.cc
@@ -213,4 +213,85 @@ std::string Processor::Normalize(const std::string& input) {
   return Verbalize(Tag(input));
 }
 
+NormalizedText Processor::NormalizeWithAlignment(const std::string& input) {
+  if (input.empty()) return {};
+  const std::string canonical = parse_type_ == ParseType::kZH_ITN ?
+      CanonicalizeAmbiguousDigitOne(input) : input;
+  StdVectorFst input_fst, lattice, path;
+  compiler_->operator()(canonical, &input_fst);
+  fst::Compose(input_fst, *tagger_, &lattice);
+  fst::ShortestPath(lattice, &path, 1, true);
+  std::string tagged;
+  printer_->operator()(path, &tagged);
+  NormalizedText result{Verbalize(tagged), {}};
+
+  // Keep the actual consumed source position at each emitted grammar byte.
+  // No text matching, edit distance or interpolation is used for provenance.
+  std::vector<size_t> consumed;
+  size_t source = 0;
+  std::string traced;
+  auto state = path.Start();
+  size_t visited = 0;
+  while (state != fst::kNoStateId && path.NumArcs(state) != 0) {
+    if (++visited > static_cast<size_t>(path.NumStates()) ||
+        path.NumArcs(state) != 1) return result;
+    fst::ArcIterator<StdVectorFst> arcs(path, state);
+    const auto& arc = arcs.Value();
+    if (arc.ilabel != 0) {
+      if (source >= canonical.size() || arc.ilabel !=
+          static_cast<unsigned char>(canonical[source])) return result;
+      ++source;
+    }
+    if (arc.olabel != 0) {
+      if (arc.olabel < 0 || arc.olabel > 255) return result;
+      traced.push_back(static_cast<char>(arc.olabel));
+      consumed.push_back(source);
+    }
+    state = arc.nextstate;
+  }
+  if (source != input.size() || canonical.size() != input.size() ||
+      traced != tagged) return result;
+
+  // The existing parser's records are flat, with quoted/escaped field values.
+  // Its field reorder and decimal repair stay inside each record. Preserve
+  // that record as the minimum source unit, including all merged/expanded text.
+  bool quoted = false, escaped = false, open = false;
+  size_t record_begin = 0, source_begin = 0;
+  std::string joined;
+  std::vector<NormalizedSpan> spans;
+  for (size_t i = 0; i < tagged.size(); ++i) {
+    const char c = tagged[i];
+    if (escaped) { escaped = false; continue; }
+    if (quoted && c == '\\') { escaped = true; continue; }
+    if (c == '"') { quoted = !quoted; continue; }
+    if (quoted) continue;
+    if (c == '{') {
+      if (open) return result;
+      open = true;
+    }
+    if (c != '}') continue;
+    if (!open) return result;
+    open = false;
+    const size_t source_end = consumed[i];
+    if (source_end <= source_begin ||
+        (source_end < input.size() &&
+         (static_cast<unsigned char>(input[source_end]) & 0xc0) == 0x80)) {
+      result.spans.clear();
+      return result;
+    }
+    const std::string piece = Verbalize(tagged.substr(record_begin, i + 1 - record_begin));
+    spans.push_back({source_begin, source_end, joined.size(), joined.size() + piece.size()});
+    joined += piece;
+    record_begin = i + 1;
+    source_begin = source_end;
+  }
+  // Fail closed if a grammar depends on context outside a record or consumes
+  // unaccounted trailing input. The ordinary normalized text remains unchanged.
+  if (!open && !quoted && source_begin == input.size() && joined == result.text &&
+      tagged.find_first_not_of(" \t\r\n", record_begin) == std::string::npos) {
+    result.spans = std::move(spans);
+  }
+  return result;
+}
+
 }  // namespace wetext
diff --git a/sherpa-onnx/csrc/wetext/processor/wetext_processor.h b/sherpa-onnx/csrc/wetext/processor/wetext_processor.h
index e11d307e..f4084d9a 100644
--- a/sherpa-onnx/csrc/wetext/processor/wetext_processor.h
+++ b/sherpa-onnx/csrc/wetext/processor/wetext_processor.h
@@ -28,12 +28,27 @@ using fst::StringCompiler;
 using fst::StringPrinter;
 
 namespace wetext {
+struct NormalizedSpan {
+  size_t source_begin;
+  size_t source_end;
+  size_t text_begin;
+  size_t text_end;
+};
+
+struct NormalizedText {
+  std::string text;
+  std::vector<NormalizedSpan> spans;
+};
+
 class Processor {
  public:
   Processor(const std::string& tagger_path, const std::string& verbalizer_path);
   std::string Tag(const std::string& input);
   std::string Verbalize(const std::string& input);
   std::string Normalize(const std::string& input);
+  // UTF-8 byte ranges from the selected tagger path, one grammar record per
+  // span. A replacement is indivisible; callers must retain mixed ownership.
+  NormalizedText NormalizeWithAlignment(const std::string& input);
 
  private:
   std::string ShortestPath(const StdVectorFst& lattice);
