+// sherpa-onnx/jni/wetext-itn.cc
+//
+// JNI bindings for WeTextProcessing ITN/TN runtime (vendored under csrc/wetext/).
+
+#include <memory>
+#include <string>
+
+#include "processor/wetext_processor.h"
+#include "sherpa-onnx/csrc/macros.h"
+#include "sherpa-onnx/jni/common.h"
+
+namespace {
+
+struct WetextItnHolder {
+  std::unique_ptr<wetext::Processor> processor;
+};
+
+static WetextItnHolder *Cast(jlong ptr) {
+  return reinterpret_cast<WetextItnHolder *>(ptr);
+}
+
+static std::string JstringToUtf8(JNIEnv *env, jstring text) {
+  const char *chars = env->GetStringUTFChars(text, nullptr);
+  std::string s(chars ? chars : "");
+  if (chars) {
+    env->ReleaseStringUTFChars(text, chars);
+  }
+  return s;
+}
+
+}  // namespace
+
+SHERPA_ONNX_EXTERN_C
+JNIEXPORT jlong JNICALL Java_com_k2fsa_sherpa_onnx_WetextItn_newFromFile(
+    JNIEnv *env, jobject /*obj*/, jstring tagger_fst, jstring verbalizer_fst,
+    jboolean /*debug*/) {
+  const char *tagger = env->GetStringUTFChars(tagger_fst, nullptr);
+  const char *verbalizer = env->GetStringUTFChars(verbalizer_fst, nullptr);
+  if (!tagger || !verbalizer) {
+    if (tagger) {
+      env->ReleaseStringUTFChars(tagger_fst, tagger);
+    }
+    if (verbalizer) {
+      env->ReleaseStringUTFChars(verbalizer_fst, verbalizer);
+    }
+    return 0;
+  }
+
+  try {
+    auto holder = new WetextItnHolder;
+    holder->processor = std::make_unique<wetext::Processor>(
+        std::string(tagger), std::string(verbalizer));
+    env->ReleaseStringUTFChars(tagger_fst, tagger);
+    env->ReleaseStringUTFChars(verbalizer_fst, verbalizer);
+    return reinterpret_cast<jlong>(holder);
+  } catch (const std::exception &e) {
+    SHERPA_ONNX_LOGE("WetextItn_newFromFile failed: %s", e.what());
+    env->ReleaseStringUTFChars(tagger_fst, tagger);
+    env->ReleaseStringUTFChars(verbalizer_fst, verbalizer);
+    return 0;
+  }
+}
+
+SHERPA_ONNX_EXTERN_C
+JNIEXPORT void JNICALL Java_com_k2fsa_sherpa_onnx_WetextItn_delete(
+    JNIEnv * /*env*/, jobject /*obj*/, jlong ptr) {
+  delete Cast(ptr);
+}
+
+SHERPA_ONNX_EXTERN_C
+JNIEXPORT jstring JNICALL Java_com_k2fsa_sherpa_onnx_WetextItn_normalize(
+    JNIEnv *env, jobject /*obj*/, jlong ptr, jstring text) {
+  auto holder = Cast(ptr);
+  if (!holder || !holder->processor) {
+    return SafeNewStringUTF(env, "");
+  }
+
+  try {
+    std::string input = JstringToUtf8(env, text);
+    if (input.empty()) {
+      return SafeNewStringUTF(env, "");
+    }
+    std::string output = holder->processor->Normalize(input);
+    return SafeNewStringUTF(env, output);
+  } catch (const std::exception &e) {
+    SHERPA_ONNX_LOGE("WetextItn_normalize failed: %s", e.what());
+    return SafeNewStringUTF(env, JstringToUtf8(env, text));
+  }
+}
