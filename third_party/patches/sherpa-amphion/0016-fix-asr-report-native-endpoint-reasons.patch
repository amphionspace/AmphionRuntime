+++ b/sherpa-onnx/c-api/c-api.h
@@ -770,6 +770,16 @@ SHERPA_ONNX_API int32_t
 SherpaOnnxOnlineStreamIsEndpoint(const SherpaOnnxOnlineRecognizer *recognizer,
                                  const SherpaOnnxOnlineStream *stream);
 
+/**
+ * @brief Return the endpoint rule selected by native priority ordering.
+ *
+ * @return 0 for none, 1 for rule1, 2 for rule2, 3 for rule3, and 4 when the
+ *         recognizer reports an endpoint without a rule-specific reason.
+ */
+SHERPA_ONNX_API int32_t SherpaOnnxOnlineStreamGetEndpointReason(
+    const SherpaOnnxOnlineRecognizer *recognizer,
+    const SherpaOnnxOnlineStream *stream);
+
 /**
  * @brief Helper for pretty-printing incremental recognition results.
  *
