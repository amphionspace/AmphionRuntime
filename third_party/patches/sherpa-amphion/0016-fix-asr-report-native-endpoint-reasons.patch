diff --git a/sherpa-onnx/csrc/endpoint-test.cc b/sherpa-onnx/csrc/endpoint-test.cc
new file mode 100644
index 00000000..92fd4e36
--- /dev/null
+++ b/sherpa-onnx/csrc/endpoint-test.cc
@@ -0,0 +1,29 @@
+// sherpa-onnx/csrc/endpoint-test.cc
+
+#include "sherpa-onnx/csrc/endpoint.h"
+
+#include "gtest/gtest.h"
+
+namespace sherpa_onnx {
+
+TEST(Endpoint, ReportsRulePriority) {
+  Endpoint endpoint(EndpointConfig{});
+
+  EXPECT_EQ(endpoint.GetEndpointReason(3000, 300, 0.01),
+            EndpointReason::kRule1);
+  EXPECT_EQ(endpoint.GetEndpointReason(3000, 200, 0.01),
+            EndpointReason::kRule2);
+  EXPECT_EQ(endpoint.GetEndpointReason(3000, 50, 0.01),
+            EndpointReason::kRule3);
+  EXPECT_EQ(endpoint.GetEndpointReason(1000, 50, 0.01),
+            EndpointReason::kNone);
+}
+
+TEST(Endpoint, BooleanResultDelegatesToReason) {
+  Endpoint endpoint(EndpointConfig{});
+
+  EXPECT_TRUE(endpoint.IsEndpoint(3000, 50, 0.01));
+  EXPECT_FALSE(endpoint.IsEndpoint(1000, 50, 0.01));
+}
+
+}  // namespace sherpa_onnx
diff --git a/sherpa-onnx/csrc/endpoint.cc b/sherpa-onnx/csrc/endpoint.cc
index afe76fdb..c1aab286 100644
--- a/sherpa-onnx/csrc/endpoint.cc
+++ b/sherpa-onnx/csrc/endpoint.cc
@@ -76,6 +76,13 @@ std::string EndpointConfig::ToString() const {
 bool Endpoint::IsEndpoint(int32_t num_frames_decoded,
                           int32_t trailing_silence_frames,
                           float frame_shift_in_seconds) const {
+  return GetEndpointReason(num_frames_decoded, trailing_silence_frames,
+                           frame_shift_in_seconds) != EndpointReason::kNone;
+}
+
+EndpointReason Endpoint::GetEndpointReason(
+    int32_t num_frames_decoded, int32_t trailing_silence_frames,
+    float frame_shift_in_seconds) const {
   float utterance_length =
       static_cast<float>(num_frames_decoded) * frame_shift_in_seconds;
 
@@ -83,14 +90,18 @@ bool Endpoint::IsEndpoint(int32_t num_frames_decoded,
       static_cast<float>(trailing_silence_frames) * frame_shift_in_seconds;
 
   if (RuleActivated(config_.rule1, "rule1", trailing_silence,
-                    utterance_length) ||
-      RuleActivated(config_.rule2, "rule2", trailing_silence,
-                    utterance_length) ||
-      RuleActivated(config_.rule3, "rule3", trailing_silence,
                     utterance_length)) {
-    return true;
+    return EndpointReason::kRule1;
+  }
+  if (RuleActivated(config_.rule2, "rule2", trailing_silence,
+                    utterance_length)) {
+    return EndpointReason::kRule2;
+  }
+  if (RuleActivated(config_.rule3, "rule3", trailing_silence,
+                    utterance_length)) {
+    return EndpointReason::kRule3;
   }
-  return false;
+  return EndpointReason::kNone;
 }
 
 }  // namespace sherpa_onnx
diff --git a/sherpa-onnx/csrc/endpoint.h b/sherpa-onnx/csrc/endpoint.h
