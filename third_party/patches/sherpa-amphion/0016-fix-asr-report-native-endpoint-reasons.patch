diff --git a/harmony-os/SherpaOnnxHar/sherpa_onnx/src/main/cpp/streaming-asr.cc b/harmony-os/SherpaOnnxHar/sherpa_onnx/src/main/cpp/streaming-asr.cc
index 697e04ab..6c25c1e7 100644
--- a/harmony-os/SherpaOnnxHar/sherpa_onnx/src/main/cpp/streaming-asr.cc
+++ b/harmony-os/SherpaOnnxHar/sherpa_onnx/src/main/cpp/streaming-asr.cc
@@ -1020,6 +1020,24 @@ static Napi::Boolean IsEndpointWrapper(const Napi::CallbackInfo &info) {
   return Napi::Boolean::New(env, is_endpoint);
 }
 
+static Napi::Number GetEndpointReasonWrapper(const Napi::CallbackInfo &info) {
+  Napi::Env env = info.Env();
+  if (info.Length() != 2 || !info[0].IsExternal() ||
+      !info[1].IsExternal()) {
+    Napi::TypeError::New(env, "Expected recognizer and stream handles.")
+        .ThrowAsJavaScriptException();
+    return {};
+  }
+
+  const SherpaOnnxOnlineRecognizer *recognizer = GetOnlineRecognizer(info, 0);
+  const SherpaOnnxOnlineStream *stream = GetOnlineStream(info, 1);
+  if (stream == nullptr) return {};
+
+  int32_t reason =
+      SherpaOnnxOnlineStreamGetEndpointReason(recognizer, stream);
+  return Napi::Number::New(env, reason);
+}
+
 static Napi::External<SherpaOnnxDisplay> CreateDisplayWrapper(
     const Napi::CallbackInfo &info) {
   Napi::Env env = info.Env();
@@ -1132,6 +1150,8 @@ void InitStreamingAsr(Napi::Env env, Napi::Object exports) {
 
   exports.Set(Napi::String::New(env, "isEndpoint"),
               Napi::Function::New(env, IsEndpointWrapper));
+  exports.Set(Napi::String::New(env, "getEndpointReason"),
+              Napi::Function::New(env, GetEndpointReasonWrapper));
 
   exports.Set(Napi::String::New(env, "createDisplay"),
               Napi::Function::New(env, CreateDisplayWrapper));
diff --git a/harmony-os/SherpaOnnxHar/sherpa_onnx/src/main/cpp/types/libsherpa_onnx/Index.d.ts b/harmony-os/SherpaOnnxHar/sherpa_onnx/src/main/cpp/types/libsherpa_onnx/Index.d.ts
