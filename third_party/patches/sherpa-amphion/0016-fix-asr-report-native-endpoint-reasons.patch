 }
 
+export enum OnlineEndpointReason {
+  NONE = 0,
+  RULE1 = 1,
+  RULE2 = 2,
+  RULE3 = 3,
+  UNKNOWN = 4,
+}
+
 export class OnlineRecognizer {
   public handle: object;
   public config: OnlineRecognizerConfig
@@ -177,6 +186,10 @@ export class OnlineRecognizer {
     return isEndpoint(this.handle, stream.handle);
   }
 
+  getEndpointReason(stream: OnlineStream): OnlineEndpointReason {
+    return getEndpointReason(this.handle, stream.handle) as OnlineEndpointReason;
+  }
+
   reset(stream: OnlineStream) {
     reset(this.handle, stream.handle);
   }
diff --git a/sherpa-onnx/c-api/c-api.cc b/sherpa-onnx/c-api/c-api.cc
index 6722b848..1006f95c 100644
--- a/sherpa-onnx/c-api/c-api.cc
+++ b/sherpa-onnx/c-api/c-api.cc
@@ -397,6 +397,14 @@ int32_t SherpaOnnxOnlineStreamIsEndpoint(
   return recognizer->impl->IsEndpoint(stream->impl.get());
 }
 
+int32_t SherpaOnnxOnlineStreamGetEndpointReason(
+    const SherpaOnnxOnlineRecognizer *recognizer,
+    const SherpaOnnxOnlineStream *stream) {
+  if (!recognizer || !stream) return 0;
+  return static_cast<int32_t>(
+      recognizer->impl->GetEndpointReason(stream->impl.get()));
+}
+
 const SherpaOnnxDisplay *SherpaOnnxCreateDisplay(int32_t max_word_per_line) {
   SherpaOnnxDisplay *ans = new SherpaOnnxDisplay;
   ans->impl = std::make_unique<sherpa_onnx::Display>(max_word_per_line);
diff --git a/sherpa-onnx/c-api/c-api.h b/sherpa-onnx/c-api/c-api.h
index fe7c2e79..7cd654c9 100644
