+#ifndef SHERPA_ONNX_HARMONY_ONLINE_STREAM_HANDLE_H_
+#define SHERPA_ONNX_HARMONY_ONLINE_STREAM_HANDLE_H_
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+#include "napi.h"  // NOLINT
+#include "sherpa-onnx/c-api/c-api.h"
+
+class OnlineStreamHandle {
+ public:
+  explicit OnlineStreamHandle(const SherpaOnnxOnlineStream *stream)
+      : stream_(stream) {
+    if (stream_ != nullptr) LiveCount().fetch_add(1);
+  }
+
+  ~OnlineStreamHandle() { Close(); }
+
+  const SherpaOnnxOnlineStream *Get() const { return stream_; }
+
+  void Close() {
+    if (stream_ == nullptr) return;
+    SherpaOnnxDestroyOnlineStream(stream_);
+    stream_ = nullptr;
+    LiveCount().fetch_sub(1);
+  }
+
+  static int64_t ActiveCount() { return LiveCount().load(); }
+
+ private:
+  static std::atomic<int64_t> &LiveCount() {
+    static std::atomic<int64_t> count{0};
+    return count;
+  }
+
+  const SherpaOnnxOnlineStream *stream_;
+};
+
+inline Napi::External<OnlineStreamHandle> WrapOnlineStream(
+    Napi::Env env, const SherpaOnnxOnlineStream *stream) {
+  auto *handle = new OnlineStreamHandle(stream);
+  return Napi::External<OnlineStreamHandle>::New(
+      env, handle, [](Napi::Env, OnlineStreamHandle *value) { delete value; });
+}
+
+inline OnlineStreamHandle *GetOnlineStreamHandle(
+    const Napi::CallbackInfo &info, size_t index) {
+  return info[index].As<Napi::External<OnlineStreamHandle>>().Data();
+}
+
+inline const SherpaOnnxOnlineStream *GetOnlineStream(
+    const Napi::CallbackInfo &info, size_t index) {
+  OnlineStreamHandle *handle = GetOnlineStreamHandle(info, index);
+  const SherpaOnnxOnlineStream *stream =
+      handle == nullptr ? nullptr : handle->Get();
+  if (stream == nullptr) {
+    Napi::Error::New(info.Env(), "Online stream is closed")
+        .ThrowAsJavaScriptException();
+  }
+  return stream;
+}
+
+#endif  // SHERPA_ONNX_HARMONY_ONLINE_STREAM_HANDLE_H_
