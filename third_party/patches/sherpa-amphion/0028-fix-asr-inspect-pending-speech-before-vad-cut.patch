+class VadEndpointProbeAsyncWorker : public Napi::AsyncWorker {
+ public:
+  VadEndpointProbeAsyncWorker(
+      Napi::Env env,
+      std::shared_ptr<OnlineRecognizerState> recognizer,
+      std::shared_ptr<OnlineStreamState> stream,
+      Napi::Promise::Deferred deferred,
+      float silence_seconds)
+      : Napi::AsyncWorker(env, "VadEndpointProbeAsyncWorker"),
+        recognizer_(std::move(recognizer)),
+        stream_(std::move(stream)),
+        deferred_(deferred),
+        silence_seconds_(silence_seconds) {}
+
+  void Execute() override {
+    try {
+      const SherpaOnnxOnlineRecognizer *recognizer =
+          recognizer_ == nullptr ? nullptr : recognizer_->Get();
+      const SherpaOnnxOnlineStream *stream =
+          stream_ == nullptr ? nullptr : stream_->Get();
+      if (recognizer == nullptr || stream == nullptr) {
+        error_ = "Online recognizer or stream is closed";
+        return;
+      }
+      wait_seconds_ = SherpaOnnxOnlineStreamGetVadEndpointWaitSeconds(
+          recognizer, stream, silence_seconds_);
+    } catch (const std::exception &e) {
+      error_ = e.what();
+    } catch (...) {
+      error_ = "Unknown native exception while inspecting pending speech";
+    }
+    // Release native leases on the worker thread. If cancel/unload already
+    // closed the JS handles, native destruction also stays off the UI thread.
+    stream_.reset();
+    recognizer_.reset();
+  }
+
+  void OnOK() override {
+    if (!error_.empty()) {
+      deferred_.Reject(Napi::Error::New(Env(), error_).Value());
+      return;
+    }
+    deferred_.Resolve(Napi::Number::New(Env(), wait_seconds_));
+  }
+
+  void OnError(const Napi::Error &error) override {
+    deferred_.Reject(error.Value());
+  }
+
+ private:
+  std::shared_ptr<OnlineRecognizerState> recognizer_;
+  std::shared_ptr<OnlineStreamState> stream_;
+  Napi::Promise::Deferred deferred_;
+  float wait_seconds_ = 0;
+  std::string error_;
+  float silence_seconds_ = 0;
+};
+
+static Napi::Value GetVadEndpointWaitSecondsAsyncWrapper(
+    const Napi::CallbackInfo &info) {
+  Napi::Env env = info.Env();
+  if (info.Length() != 3 || !info[0].IsExternal() ||
+      !info[1].IsExternal() || !info[2].IsNumber()) {
+    Napi::TypeError::New(
+        env, "Expected recognizer, stream, and trailing silence seconds")
+        .ThrowAsJavaScriptException();
+    return env.Null();
+  }
+
+  OnlineRecognizerHandle *recognizer_handle =
+      GetOnlineRecognizerHandle(info, 0);
+  OnlineStreamHandle *stream_handle = GetOnlineStreamHandle(info, 1);
+  std::shared_ptr<OnlineRecognizerState> recognizer =
+      recognizer_handle == nullptr ? nullptr : recognizer_handle->Lease();
+  std::shared_ptr<OnlineStreamState> stream =
+      stream_handle == nullptr ? nullptr : stream_handle->Lease();
+  if (recognizer == nullptr || recognizer->Get() == nullptr ||
+      stream == nullptr || stream->Get() == nullptr) {
+    Napi::Error::New(env, "Online recognizer or stream is closed")
+        .ThrowAsJavaScriptException();
+    return env.Null();
+  }
+
+  Napi::Promise::Deferred deferred = Napi::Promise::Deferred::New(env);
+  auto *worker = new VadEndpointProbeAsyncWorker(
+      env, std::move(recognizer), std::move(stream), deferred, info[2].As<Napi::Number>().FloatValue());
+  try {
+    worker->Queue();
+  } catch (...) {
+    delete worker;
+    throw;
+  }
+  return deferred.Promise();
+}
+
 static Napi::Value DecodeOnlineStreamAsyncWrapper(
     const Napi::CallbackInfo &info) {
   return StartDecodeOnlineStreamAsync(info, true);
@@ -1041,6 +1136,21 @@ static Napi::Boolean IsEndpointWrapper(const Napi::CallbackInfo &info) {
   return Napi::Boolean::New(env, is_endpoint);
