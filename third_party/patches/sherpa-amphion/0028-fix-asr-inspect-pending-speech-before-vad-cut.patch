diff --git a/sherpa-onnx/csrc/online-recognizer-transducer-impl.h b/sherpa-onnx/csrc/online-recognizer-transducer-impl.h
index af59d434..baf5d20c 100644
--- a/sherpa-onnx/csrc/online-recognizer-transducer-impl.h
+++ b/sherpa-onnx/csrc/online-recognizer-transducer-impl.h
@@ -385,6 +385,86 @@ class OnlineRecognizerTransducerImpl : public OnlineRecognizerImpl {
     return r;
   }
 
+  float GetVadEndpointWaitSeconds(OnlineStream *s, float silence_seconds) const override {
+    // This is a veto of destructive VAD endpointing, never a public hypothesis.
+    // Future right context is synthetic; only encoder output frames belonging
+    // to the already available real features may reach the disposable decoder.
+    const int32_t ready = s->NumFramesReady();
+    const int32_t begin = s->GetNumProcessedFrames();
+    const int32_t chunk_size = model_->ChunkSize();
+    const int32_t chunk_shift = model_->ChunkShift();
+    const int32_t dim = s->FeatureDim();
+    constexpr int32_t subsampling = 4;
+    std::vector<OnlineTransducerDecoderResult> results{s->GetResult()};
+    std::vector<Ort::Value> states;
+    for (const auto &state : s->GetStates()) {
+      states.push_back(Clone(model_->Allocator(), &state));
+    }
+
+    // GetFrames discards only frames preceding begin, exactly as the next
+    // ordinary decode would. It never consumes pending frames or advances the
+    // stream's frame count, encoder state, hypothesis, or public segment.
+    const int32_t pending_count = std::max(0, ready - begin);
+    auto pending = s->GetFrames(begin, pending_count);
+    FeatureExtractor silence(config_.feat_config);
+    std::vector<float> zero_samples(
+        static_cast<int32_t>(config_.feat_config.sampling_rate), 0.0f);
+    silence.AcceptWaveform(config_.feat_config.sampling_rate,
+                           zero_samples.data(), zero_samples.size());
+    auto silence_frame = silence.GetFrames(0, 1);
+    auto memory_info =
+        Ort::MemoryInfo::CreateCpu(OrtDeviceAllocator, OrtMemTypeDefault);
+    for (int32_t pos = begin; pos + subsampling <= ready; pos += chunk_shift) {
+      std::vector<float> features(chunk_size * dim);
+      for (int32_t t = 0; t < chunk_size; ++t) {
+        const int32_t source = pos - begin + t;
+        const float *frame = source < pending_count ?
+            pending.data() + source * dim : silence_frame.data();
+        std::copy(frame, frame + dim, features.data() + t * dim);
+      }
+      std::array<int64_t, 3> shape{1, chunk_size, dim};
+      auto x = Ort::Value::CreateTensor(memory_info, features.data(), features.size(),
+                                        shape.data(), shape.size());
+      int64_t processed = pos;
+      std::array<int64_t, 1> processed_shape{1};
+      auto processed_frames = Ort::Value::CreateTensor(memory_info, &processed, 1,
+          processed_shape.data(), processed_shape.size());
+      auto pair = model_->RunEncoder(std::move(x), std::move(states),
+                                     std::move(processed_frames));
+      auto output_shape = pair.first.GetTensorTypeAndShapeInfo().GetShape();
+      output_shape[1] = std::min<int64_t>(output_shape[1], (ready - pos) / subsampling);
+      const size_t output_size = output_shape[1] * output_shape[2];
+      auto bounded_output = Ort::Value::CreateTensor(memory_info,
+          pair.first.GetTensorMutableData<float>(), output_size,
+          output_shape.data(), output_shape.size());
+      if (s->GetContextGraph()) {
+        decoder_->Decode(std::move(bounded_output), &s, &results);
+      } else {
+        decoder_->Decode(std::move(bounded_output), &results);
+      }
+      states = std::move(pair.second);
+    }
+    decoder_->StripLeadingBlanks(&results[0]);
+    int32_t last = -1;
+    if (!s->GetCommittedPrefix().timestamps.empty()) {
+      last = s->GetCommittedPrefix().timestamps.back();
+    }
+    if (!results[0].timestamps.empty()) {
+      last = std::max(last, results[0].timestamps.back());
+    }
+    float wait = last < 0 ? 0.0f : std::max(0.0f,
+        silence_seconds - (ready - (last + 1) * subsampling) * 0.01f);
+    auto original = s->GetResult();
+    decoder_->StripLeadingBlanks(&original);
+    if (original.tokens != results[0].tokens) {
+      // Even with a short vadEnd, a newly revealed real token cannot be lost.
+      // Wait until the next natural decode can commit/revise that hypothesis.
+      // IsReady uses a strict inequality, hence the extra feature frame.
+      wait = std::max(wait, (begin + chunk_size + 1 - ready) * 0.01f);
+    }
+    return wait;
+  }
+
   bool IsEndpoint(OnlineStream *s) const override {
     return GetEndpointReason(s) != EndpointReason::kNone;
   }
