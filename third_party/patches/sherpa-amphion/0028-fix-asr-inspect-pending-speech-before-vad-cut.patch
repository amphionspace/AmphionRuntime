+static Napi::Number GetVadEndpointWaitSecondsWrapper(const Napi::CallbackInfo &info) {
+  Napi::Env env = info.Env();
+  if (info.Length() != 3 || !info[0].IsExternal() ||
+      !info[1].IsExternal() || !info[2].IsNumber()) {
+    Napi::TypeError::New(env, "Expected recognizer, stream, and trailing silence seconds")
+        .ThrowAsJavaScriptException();
+    return {};
+  }
+  const auto *recognizer = GetOnlineRecognizer(info, 0);
+  const auto *stream = GetOnlineStream(info, 1);
+  if (stream == nullptr) return {};
+  return Napi::Number::New(env, SherpaOnnxOnlineStreamGetVadEndpointWaitSeconds(
+      recognizer, stream, info[2].As<Napi::Number>().FloatValue()));
+}
+
