From e48be0c73189efc2ce0e65c24de30771bbaa72f3 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Tue, 1 Sep 2026 09:10:47 +0800
Subject: [PATCH] feat(c-api): expose Amphion speaker turn segmentation

---
 sherpa-onnx/c-api/c-api.cc | 157 +++++++++++++++++++++++++++++++++++++
 sherpa-onnx/c-api/c-api.h  |  29 +++++++
 2 files changed, 186 insertions(+)

diff --git a/sherpa-onnx/c-api/c-api.cc b/sherpa-onnx/c-api/c-api.cc
index a18304cf..f435dbb3 100644
--- a/sherpa-onnx/c-api/c-api.cc
+++ b/sherpa-onnx/c-api/c-api.cc
@@ -5,14 +5,18 @@
 #include "sherpa-onnx/c-api/c-api.h"
 
 #include <algorithm>
+#include <array>
 #include <cstring>
 #include <memory>
+#include <mutex>
 #include <sstream>
+#include <stdexcept>
 #include <string>
 #include <utility>
 #include <vector>
 
 #include "nlohmann/json.hpp"
+#include "onnxruntime_cxx_api.h"
 
 #if __OHOS__
 #include "rawfile/raw_file_manager.h"
@@ -72,6 +76,159 @@ struct SherpaOnnxWetextItn {
   std::unique_ptr<wetext::Processor> impl;
 };
 
+namespace {
+
+constexpr int64_t kSpeakerTurnWindowSamples = 160000;
+constexpr int64_t kSpeakerTurnFrames = 589;
+constexpr int64_t kSpeakerTurnClasses = 7;
+constexpr int32_t kSpeakerTurnReceptiveFieldSize = 991;
+constexpr int32_t kSpeakerTurnReceptiveFieldShift = 270;
+
+constexpr int32_t SpeakerTurnClassToMask(int32_t klass) {
+  constexpr std::array<int32_t, kSpeakerTurnClasses> kMasks{0, 1, 2, 4, 3, 5,
+                                                            6};
+  return klass >= 0 && klass < kSpeakerTurnClasses ? kMasks[klass] : 0;
+}
+
+constexpr int32_t SpeakerTurnPrimarySpeaker(int32_t mask) {
+  if ((mask & 1) != 0) return 0;
+  if ((mask & 2) != 0) return 1;
+  if ((mask & 4) != 0) return 2;
+  return -1;
+}
+
+class SpeakerTurnSegmenterImpl {
+ public:
+  explicit SpeakerTurnSegmenterImpl(const char *model_path)
+      : env_(ORT_LOGGING_LEVEL_WARNING, "amphion-speaker-turn") {
+    Ort::SessionOptions options;
+    options.SetExecutionMode(ExecutionMode::ORT_SEQUENTIAL);
+    options.SetIntraOpNumThreads(1);
+    options.SetInterOpNumThreads(1);
+    options.DisableCpuMemArena();
+    options.DisableMemPattern();
+    options.SetGraphOptimizationLevel(GraphOptimizationLevel::ORT_ENABLE_EXTENDED);
+    const std::string model(model_path);
+    session_ = Ort::Session(env_, SHERPA_ONNX_TO_ORT_PATH(model), options);
+    Ort::AllocatorWithDefaultOptions allocator;
+    input_name_ = session_.GetInputNameAllocated(0, allocator).get();
+    output_name_ = session_.GetOutputNameAllocated(0, allocator).get();
+  }
+
+  std::vector<SherpaOnnxSpeakerTurnSegment> Process(const float *samples,
+                                                     int32_t sample_count) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    const int32_t source_offset =
+        sample_count > kSpeakerTurnWindowSamples
+            ? sample_count - static_cast<int32_t>(kSpeakerTurnWindowSamples)
+            : 0;
+    std::vector<float> window(kSpeakerTurnWindowSamples, 0.0F);
+    const int32_t copied = std::min(
+        sample_count, static_cast<int32_t>(kSpeakerTurnWindowSamples));
+    std::copy(samples + sample_count - copied, samples + sample_count,
+              window.begin());
+    std::array<int64_t, 3> shape{1, 1, kSpeakerTurnWindowSamples};
+    auto memory = Ort::MemoryInfo::CreateCpu(OrtArenaAllocator, OrtMemTypeDefault);
+    Ort::Value input = Ort::Value::CreateTensor<float>(
+        memory, window.data(), window.size(), shape.data(), shape.size());
+    const char *input_names[] = {input_name_.c_str()};
+    const char *output_names[] = {output_name_.c_str()};
+    auto output = session_.Run(Ort::RunOptions{nullptr}, input_names, &input, 1,
+                               output_names, 1);
+    if (output.size() != 1 || !output[0].IsTensor() ||
+        output[0].GetTensorTypeAndShapeInfo().GetElementCount() !=
+            kSpeakerTurnFrames * kSpeakerTurnClasses) {
+      throw std::runtime_error("speaker segmentation returned invalid output");
+    }
+    const float *logits = output[0].GetTensorData<float>();
+    std::vector<SherpaOnnxSpeakerTurnSegment> result;
+    int32_t active_mask = 0;
+    int32_t active_start = 0;
+    auto finish = [&](int32_t end) {
+      if (active_mask != 0 && end > active_start) {
+        result.push_back({active_start, end,
+                          SpeakerTurnPrimarySpeaker(active_mask), active_mask});
+      }
+      active_mask = 0;
+    };
+    for (int32_t frame = 0; frame < kSpeakerTurnFrames; ++frame) {
+      const float *row = logits + frame * kSpeakerTurnClasses;
+      const int32_t klass = static_cast<int32_t>(
+          std::max_element(row, row + kSpeakerTurnClasses) - row);
+      const int32_t mask = SpeakerTurnClassToMask(klass);
+      const int32_t boundary = std::clamp(
+          source_offset + kSpeakerTurnReceptiveFieldSize / 2 +
+              frame * kSpeakerTurnReceptiveFieldShift,
+          0, sample_count);
+      if (mask == active_mask) continue;
+      finish(boundary);
+      if (mask != 0) {
+        active_mask = mask;
+        active_start = boundary;
+      }
+    }
+    finish(sample_count);
+    return result;
+  }
+
+ private:
+  Ort::Env env_;
+  Ort::Session session_{nullptr};
+  std::string input_name_;
+  std::string output_name_;
+  std::mutex mutex_;
+};
+
+}  // namespace
+
+struct SherpaOnnxSpeakerTurnSegmenter {
+  std::unique_ptr<SpeakerTurnSegmenterImpl> impl;
+};
+
+const SherpaOnnxSpeakerTurnSegmenter *SherpaOnnxCreateSpeakerTurnSegmenter(
+    const char *model_path) {
+  if (model_path == nullptr || model_path[0] == '\0') return nullptr;
+  try {
+    auto *segmenter = new SherpaOnnxSpeakerTurnSegmenter;
+    segmenter->impl = std::make_unique<SpeakerTurnSegmenterImpl>(model_path);
+    return segmenter;
+  } catch (const std::exception &e) {
+    SHERPA_ONNX_LOGE("Failed to create speaker turn segmenter: %s", e.what());
+    return nullptr;
+  }
+}
+
+const SherpaOnnxSpeakerTurnSegment *SherpaOnnxSpeakerTurnSegmenterProcess(
+    const SherpaOnnxSpeakerTurnSegmenter *segmenter, const float *samples,
+    int32_t sample_count, int32_t *segment_count) {
+  if (segment_count != nullptr) *segment_count = 0;
+  if (segmenter == nullptr || segmenter->impl == nullptr || samples == nullptr ||
+      sample_count <= 0 || segment_count == nullptr) {
+    return nullptr;
+  }
+  try {
+    auto result = segmenter->impl->Process(samples, sample_count);
+    if (result.empty()) return nullptr;
+    auto *segments = new SherpaOnnxSpeakerTurnSegment[result.size()];
+    std::copy(result.begin(), result.end(), segments);
+    *segment_count = static_cast<int32_t>(result.size());
+    return segments;
+  } catch (const std::exception &e) {
+    SHERPA_ONNX_LOGE("Failed to process speaker turns: %s", e.what());
+    return nullptr;
+  }
+}
+
+void SherpaOnnxDestroySpeakerTurnSegments(
+    const SherpaOnnxSpeakerTurnSegment *segments) {
+  delete[] segments;
+}
+
+void SherpaOnnxDestroySpeakerTurnSegmenter(
+    const SherpaOnnxSpeakerTurnSegmenter *segmenter) {
+  delete segmenter;
+}
+
 #define SHERPA_ONNX_OR(x, y) (x ? x : y)
 
 static sherpa_onnx::OnlineRecognizerConfig GetOnlineRecognizerConfig(
diff --git a/sherpa-onnx/c-api/c-api.h b/sherpa-onnx/c-api/c-api.h
index ac8f6d98..776d37be 100644
--- a/sherpa-onnx/c-api/c-api.h
+++ b/sherpa-onnx/c-api/c-api.h
@@ -3923,6 +3923,35 @@ SHERPA_ONNX_API void SherpaOnnxOfflineSpeakerDiarizationSetConfig(
 typedef struct SherpaOnnxOfflineSpeakerDiarizationResult
     SherpaOnnxOfflineSpeakerDiarizationResult;
 
+/**
+ * Amphion-compatible pyannote segmentation wrapper. Unlike sherpa's full
+ * diarization API, this accepts the repository's metadata-free
+ * pyannote-segmentation-3.0 model and exposes the same powerset decoding used
+ * by the Android and HarmonyOS adapters.
+ */
+typedef struct SherpaOnnxSpeakerTurnSegmenter SherpaOnnxSpeakerTurnSegmenter;
+
+typedef struct SherpaOnnxSpeakerTurnSegment {
+  int32_t start_sample;
+  int32_t end_sample;
+  int32_t speaker_index;
+  int32_t speaker_mask;
+} SherpaOnnxSpeakerTurnSegment;
+
+SHERPA_ONNX_API const SherpaOnnxSpeakerTurnSegmenter *
+SherpaOnnxCreateSpeakerTurnSegmenter(const char *model_path);
+
+SHERPA_ONNX_API const SherpaOnnxSpeakerTurnSegment *
+SherpaOnnxSpeakerTurnSegmenterProcess(
+    const SherpaOnnxSpeakerTurnSegmenter *segmenter, const float *samples,
+    int32_t sample_count, int32_t *segment_count);
+
+SHERPA_ONNX_API void SherpaOnnxDestroySpeakerTurnSegments(
+    const SherpaOnnxSpeakerTurnSegment *segments);
+
+SHERPA_ONNX_API void SherpaOnnxDestroySpeakerTurnSegmenter(
+    const SherpaOnnxSpeakerTurnSegmenter *segmenter);
+
 /**
  * @brief One diarization segment.
  */
