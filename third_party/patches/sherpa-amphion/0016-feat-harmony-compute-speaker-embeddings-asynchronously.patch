 }
 
+class SpeakerEmbeddingExtractorComputeAsyncWorker : public Napi::AsyncWorker {
+ public:
+  SpeakerEmbeddingExtractorComputeAsyncWorker(
+      Napi::Env env,
+      std::shared_ptr<SpeakerEmbeddingExtractorState> extractor,
+      std::shared_ptr<OnlineStreamState> stream,
+      Napi::Promise::Deferred deferred)
+      : Napi::AsyncWorker(env, "SpeakerEmbeddingExtractorComputeAsyncWorker"),
+        extractor_(std::move(extractor)),
+        stream_(std::move(stream)),
+        deferred_(deferred) {}
+
+  void Execute() override {
+    try {
+      const SherpaOnnxSpeakerEmbeddingExtractor *extractor =
+          extractor_ == nullptr ? nullptr : extractor_->Get();
+      const SherpaOnnxOnlineStream *stream =
+          stream_ == nullptr ? nullptr : stream_->Get();
+      if (extractor == nullptr || stream == nullptr) {
+        error_ = "Speaker embedding extractor or stream is closed";
+        return;
+      }
+      std::lock_guard<std::mutex> lock(extractor_->InferenceMutex());
+      const float *embedding =
+          SherpaOnnxSpeakerEmbeddingExtractorComputeEmbedding(extractor, stream);
+      if (embedding == nullptr) {
+        error_ = "Speaker embedding extraction returned no result";
+        return;
+      }
+      const int32_t dim = SherpaOnnxSpeakerEmbeddingExtractorDim(extractor);
+      values_.assign(embedding, embedding + dim);
+      SherpaOnnxSpeakerEmbeddingExtractorDestroyEmbedding(embedding);
+    } catch (const std::exception &e) {
+      error_ = e.what();
+    } catch (...) {
+      error_ = "Unknown native exception while extracting speaker embedding";
+    }
+    stream_.reset();
+    extractor_.reset();
+  }
+
+  void OnOK() override {
+    if (!error_.empty()) {
+      deferred_.Reject(Napi::Error::New(Env(), error_).Value());
+      return;
+    }
+    Napi::ArrayBuffer buffer =
+        Napi::ArrayBuffer::New(Env(), values_.size() * sizeof(float));
+    Napi::Float32Array result =
+        Napi::Float32Array::New(Env(), values_.size(), buffer, 0);
+    std::copy(values_.begin(), values_.end(), result.Data());
+    deferred_.Resolve(result);
+  }
+
+  void OnError(const Napi::Error &error) override {
+    deferred_.Reject(error.Value());
+  }
+
+ private:
+  std::shared_ptr<SpeakerEmbeddingExtractorState> extractor_;
+  std::shared_ptr<OnlineStreamState> stream_;
+  Napi::Promise::Deferred deferred_;
+  std::vector<float> values_;
+  std::string error_;
+};
+
+static Napi::Value SpeakerEmbeddingExtractorComputeEmbeddingAsyncWrapper(
+    const Napi::CallbackInfo &info) {
+  Napi::Env env = info.Env();
+  if (info.Length() != 2 || !info[0].IsExternal() ||
+      !info[1].IsExternal()) {
+    Napi::TypeError::New(env, "Expected speaker extractor and stream handles")
+        .ThrowAsJavaScriptException();
+    return env.Null();
+  }
+  auto *extractor_handle = GetSpeakerEmbeddingExtractorHandle(info, 0);
+  auto *stream_handle = GetOnlineStreamHandle(info, 1);
+  auto extractor = extractor_handle == nullptr ? nullptr : extractor_handle->Lease();
+  auto stream = stream_handle == nullptr ? nullptr : stream_handle->Lease();
+  if (extractor == nullptr || extractor->Get() == nullptr ||
+      stream == nullptr || stream->Get() == nullptr) {
+    Napi::Error::New(env, "Speaker embedding extractor or stream is closed")
+        .ThrowAsJavaScriptException();
+    return env.Null();
+  }
+  Napi::Promise::Deferred deferred = Napi::Promise::Deferred::New(env);
+  auto *worker = new SpeakerEmbeddingExtractorComputeAsyncWorker(
+      env, std::move(extractor), std::move(stream), deferred);
+  try {
+    worker->Queue();
+  } catch (...) {
+    delete worker;
+    deferred.Reject(Napi::Error::New(env, "Failed to queue speaker embedding work").Value());
+    return deferred.Promise();
+  }
+  return deferred.Promise();
+}
+
 static void DestroySpeakerEmbeddingExtractorWrapper(
     const Napi::CallbackInfo &info) {
   Napi::Env env = info.Env();
@@ -1069,6 +1178,11 @@ void InitSpeakerID(Napi::Env env, Napi::Object exports) {
       Napi::Function::New(env,
                           SpeakerEmbeddingExtractorComputeEmbeddingWrapper));
 
+  exports.Set(
+      Napi::String::New(env, "speakerEmbeddingExtractorComputeEmbeddingAsync"),
+      Napi::Function::New(
+          env, SpeakerEmbeddingExtractorComputeEmbeddingAsyncWrapper));
+
   exports.Set(
       Napi::String::New(env, "destroySpeakerEmbeddingExtractor"),
       Napi::Function::New(env, DestroySpeakerEmbeddingExtractorWrapper));
