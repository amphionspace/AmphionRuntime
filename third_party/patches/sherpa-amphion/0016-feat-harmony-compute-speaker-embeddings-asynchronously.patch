 #ifndef SHERPA_ONNX_HARMONY_SPEAKER_EMBEDDING_EXTRACTOR_HANDLE_H_
 #define SHERPA_ONNX_HARMONY_SPEAKER_EMBEDDING_EXTRACTOR_HANDLE_H_
 
+#include <memory>
