 #include "napi.h"  // NOLINT
 #include "sherpa-onnx/c-api/c-api.h"
 
-class SpeakerEmbeddingExtractorHandle {
+class SpeakerEmbeddingExtractorState {
  public:
-  explicit SpeakerEmbeddingExtractorHandle(
+  explicit SpeakerEmbeddingExtractorState(
       const SherpaOnnxSpeakerEmbeddingExtractor *extractor)
       : extractor_(extractor) {}
 
-  ~SpeakerEmbeddingExtractorHandle() { Close(); }
+  ~SpeakerEmbeddingExtractorState() {
+    if (extractor_ != nullptr) {
+      SherpaOnnxDestroySpeakerEmbeddingExtractor(extractor_);
+    }
+  }
 
   const SherpaOnnxSpeakerEmbeddingExtractor *Get() const { return extractor_; }
+  std::mutex &InferenceMutex() { return inference_mutex_; }
+
+ private:
+  const SherpaOnnxSpeakerEmbeddingExtractor *extractor_;
+  std::mutex inference_mutex_;
+};
+
+class SpeakerEmbeddingExtractorHandle {
+ public:
+  explicit SpeakerEmbeddingExtractorHandle(
+      const SherpaOnnxSpeakerEmbeddingExtractor *extractor)
+      : state_(std::make_shared<SpeakerEmbeddingExtractorState>(extractor)) {}
+
+  const SherpaOnnxSpeakerEmbeddingExtractor *Get() const {
+    return state_ == nullptr ? nullptr : state_->Get();
+  }
+
+  std::shared_ptr<SpeakerEmbeddingExtractorState> Lease() const {
+    return state_;
+  }
 
   void Close() {
-    if (extractor_ == nullptr) return;
-    SherpaOnnxDestroySpeakerEmbeddingExtractor(extractor_);
-    extractor_ = nullptr;
+    state_.reset();
   }
 
  private:
-  const SherpaOnnxSpeakerEmbeddingExtractor *extractor_;
+  std::shared_ptr<SpeakerEmbeddingExtractorState> state_;
 };
 
 inline Napi::External<SpeakerEmbeddingExtractorHandle>
