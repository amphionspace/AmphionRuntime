diff --git a/sherpa-onnx/csrc/online-transducer-modified-beam-search-decoder.cc b/sherpa-onnx/csrc/online-transducer-modified-beam-search-decoder.cc
index 8058f9ae..2cce2dff 100644
--- a/sherpa-onnx/csrc/online-transducer-modified-beam-search-decoder.cc
+++ b/sherpa-onnx/csrc/online-transducer-modified-beam-search-decoder.cc
@@ -296,4 +296,126 @@ bool OnlineTransducerModifiedBeamSearchDecoder::CommitRule3Segment(
   return true;
 }
 
+bool OnlineTransducerModifiedBeamSearchDecoder::CommitStablePrefix(
+    OnlineTransducerDecoderResult *result, int32_t context_size,
+    OnlineTransducerDecoderResult *committed) const {
+  if (result == nullptr || committed == nullptr || context_size <= 0 ||
+      result->hyps.Size() == 0) {
+    return false;
+  }
+
+  auto candidates = result->hyps.Vec();
+  int32_t common_end = static_cast<int32_t>(candidates.front().ys.size());
+  for (const auto &candidate : candidates) {
+    common_end =
+        std::min(common_end, static_cast<int32_t>(candidate.ys.size()));
+  }
+
+  for (int32_t i = context_size; i < common_end; ++i) {
+    const auto token = candidates.front().ys[i];
+    const auto timestamp_index = i - context_size;
+    if (timestamp_index >=
+        static_cast<int32_t>(candidates.front().timestamps.size())) {
+      common_end = i;
+      break;
+    }
+    const auto timestamp = candidates.front().timestamps[timestamp_index];
+
+    bool shared = true;
+    for (auto candidate = candidates.begin() + 1;
+         candidate != candidates.end(); ++candidate) {
+      if (candidate->ys[i] != token ||
+          timestamp_index >=
+              static_cast<int32_t>(candidate->timestamps.size()) ||
+          candidate->timestamps[timestamp_index] != timestamp) {
+        shared = false;
+        break;
+      }
+    }
+    if (!shared) {
+      common_end = i;
+      break;
+    }
+  }
+
+  // Classic LM rescoring may intentionally leave the newest tokens unscored
+  // until a complete LM chunk is available. Its recurrent state only includes
+  // cur_scored_pos tokens, so keep any newer common tokens in the live tail.
+  // Shallow fusion advances its LM state token-by-token and needs no such cap.
+  if (lm_ && !shallow_fusion_) {
+    for (const auto &candidate : candidates) {
+      common_end = std::min(common_end,
+                            context_size + candidate.cur_scored_pos);
+    }
+  }
+
+  const int32_t committed_count = common_end - context_size;
+  if (committed_count <= 0) {
+    return false;
+  }
+
+  const auto best = result->hyps.GetMostProbable(true);
+  auto has_prefix = [committed_count](const auto &values) {
+    return values.empty() ||
+           static_cast<int32_t>(values.size()) >= committed_count;
+  };
+  if (!has_prefix(best.timestamps) || !has_prefix(best.ys_probs) ||
+      !has_prefix(best.lm_probs) || !has_prefix(best.context_scores)) {
+    return false;
+  }
+
+  OnlineTransducerDecoderResult prefix;
+  prefix.frame_offset = result->frame_offset;
+  prefix.tokens.assign(best.ys.begin() + context_size,
+                       best.ys.begin() + common_end);
+  auto copy_prefix = [committed_count](const auto &src, auto *dest) {
+    if (!src.empty()) {
+      dest->assign(src.begin(), src.begin() + committed_count);
+    }
+  };
+  copy_prefix(best.timestamps, &prefix.timestamps);
+  copy_prefix(best.ys_probs, &prefix.ys_probs);
+  copy_prefix(best.lm_probs, &prefix.lm_probs);
+  copy_prefix(best.context_scores, &prefix.context_scores);
+
+  for (const auto &candidate : candidates) {
+    if (!has_prefix(candidate.timestamps) || !has_prefix(candidate.ys_probs) ||
+        !has_prefix(candidate.lm_probs) ||
+        !has_prefix(candidate.context_scores)) {
+      return false;
+    }
+  }
+
+  Hypotheses compacted;
+  for (auto &candidate : candidates) {
+    candidate.length_normalization_offset += committed_count;
+    candidate.ys.erase(candidate.ys.begin(),
+                       candidate.ys.begin() + committed_count);
+    auto erase_prefix = [committed_count](auto *values) {
+      if (!values->empty()) {
+        values->erase(values->begin(), values->begin() + committed_count);
+      }
+    };
+    erase_prefix(&candidate.timestamps);
+    erase_prefix(&candidate.ys_probs);
+    erase_prefix(&candidate.lm_probs);
+    erase_prefix(&candidate.context_scores);
+    candidate.cur_scored_pos =
+        std::max(0, candidate.cur_scored_pos - committed_count);
+    compacted.Add(std::move(candidate));
+  }
+
+  result->hyps = std::move(compacted);
+  auto compacted_best = result->hyps.GetMostProbable(true);
+  result->tokens = compacted_best.ys;
+  result->timestamps = compacted_best.timestamps;
+  result->ys_probs = compacted_best.ys_probs;
+  result->lm_probs = compacted_best.lm_probs;
+  result->context_scores = compacted_best.context_scores;
+  result->decoder_out = Ort::Value{nullptr};
+
+  *committed = std::move(prefix);
+  return true;
+}
+
 }  // namespace sherpa_onnx
