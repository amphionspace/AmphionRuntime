+TEST(OnlineTransducerRule3Checkpoint,
+     StablePrefixDefersWhenCandidateFrameBoundariesDiffer) {
+  OnlineTransducerModifiedBeamSearchDecoder decoder(
+      nullptr, nullptr, 8, 0, false, -1, 0, 1);
+  OnlineTransducerDecoderResult result;
+
+  Hypothesis first({-1, 0, 10, 11, 20}, 10);
+  first.timestamps = {2, 4, 6};
+  Hypothesis second({-1, 0, 10, 11, 30}, 9);
+  second.timestamps = {2, 5, 7};
+  result.hyps.Add(std::move(first));
+  result.hyps.Add(std::move(second));
+  result.tokens = result.hyps.GetMostProbable(true).ys;
+  const auto original = result.hyps.Vec();
+
+  OnlineTransducerDecoderResult committed;
+  ASSERT_TRUE(decoder.CommitStablePrefix(&result, 2, &committed));
+  EXPECT_EQ(committed.tokens, (std::vector<int64_t>{10}));
+  EXPECT_EQ(committed.timestamps, (std::vector<int32_t>{2}));
+  ASSERT_EQ(result.hyps.Size(), 2);
+  for (const auto &candidate : result.hyps) {
+    EXPECT_EQ(candidate.second.ys.size(), 4);
+    EXPECT_EQ(candidate.second.timestamps.size(), 2);
+    EXPECT_EQ(candidate.second.ys[2], 11);
+  }
+  EXPECT_EQ(original.size(), 2);
+}
+
+TEST(OnlineTransducerRule3Checkpoint,
+     StablePrefixLeavesStateUnchangedWithoutSharedToken) {
+  OnlineTransducerModifiedBeamSearchDecoder decoder(
+      nullptr, nullptr, 8, 0, false, -1, 0, 1);
+  OnlineTransducerDecoderResult result;
+
+  Hypothesis first({-1, 0, 10}, 10);
+  first.timestamps = {2};
+  Hypothesis second({-1, 0, 20}, 9);
+  second.timestamps = {2};
+  result.hyps.Add(std::move(first));
+  result.hyps.Add(std::move(second));
+  result.tokens = result.hyps.GetMostProbable(true).ys;
+  const auto original_tokens = result.tokens;
+  const auto original_hyps = result.hyps.ToString();
+
+  OnlineTransducerDecoderResult committed;
+  EXPECT_FALSE(decoder.CommitStablePrefix(&result, 2, &committed));
+  EXPECT_EQ(result.tokens, original_tokens);
+  EXPECT_EQ(result.hyps.ToString(), original_hyps);
+  EXPECT_TRUE(committed.tokens.empty());
+}
+
+TEST(OnlineTransducerRule3Checkpoint,
+     StreamAccumulatesCommittedTranscriptOutsideActiveBeams) {
+  OnlineStream stream;
+  OnlineTransducerDecoderResult first;
+  first.tokens = {10, 11};
+  first.timestamps = {2, 4};
+  OnlineTransducerDecoderResult second;
+  second.tokens = {12};
+  second.timestamps = {6};
+
+  stream.AppendCommittedPrefix(first);
+  stream.AppendCommittedPrefix(second);
+  EXPECT_EQ(stream.GetCommittedPrefix().tokens,
+            (std::vector<int64_t>{10, 11, 12}));
+  EXPECT_EQ(stream.GetCommittedPrefix().timestamps,
+            (std::vector<int32_t>{2, 4, 6}));
+  stream.ClearCommittedPrefix();
+  EXPECT_TRUE(stream.GetCommittedPrefix().tokens.empty());
+}
