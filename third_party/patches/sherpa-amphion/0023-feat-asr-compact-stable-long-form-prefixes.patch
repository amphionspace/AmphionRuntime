diff --git a/sherpa-onnx/csrc/online-transducer-rule3-checkpoint-test.cc b/sherpa-onnx/csrc/online-transducer-rule3-checkpoint-test.cc
index 151f8ae4..648f0f7e 100644
--- a/sherpa-onnx/csrc/online-transducer-rule3-checkpoint-test.cc
+++ b/sherpa-onnx/csrc/online-transducer-rule3-checkpoint-test.cc
@@ -123,6 +123,121 @@ TEST(OnlineTransducerRule3Checkpoint,
   EXPECT_EQ(result.hyps.GetMostProbable(true).length_normalization_offset, 101);
 }
 
+TEST(OnlineTransducerRule3Checkpoint,
+     StablePrefixPreservesCandidatesThatCanReverseLater) {
+  OnlineTransducerModifiedBeamSearchDecoder decoder(
+      nullptr, nullptr, 8, 0, false, -1, 0, 1);
+  OnlineTransducerDecoderResult result;
+
+  Hypothesis current_best({-1, 0, 10, 11, 20}, 10);
+  current_best.timestamps = {2, 4, 6};
+  current_best.ys_probs = {-0.1, -0.2, -0.3};
+  Hypothesis future_best({-1, 0, 10, 11, 30}, 9);
+  future_best.timestamps = {2, 4, 7};
+  future_best.ys_probs = {-0.1, -0.2, -0.4};
+  result.hyps.Add(std::move(current_best));
+  result.hyps.Add(std::move(future_best));
+  result.tokens = result.hyps.GetMostProbable(true).ys;
+  result.frame_offset = 100;
+  result.num_trailing_blanks = 3;
+
+  OnlineTransducerDecoderResult committed;
+  ASSERT_TRUE(decoder.CommitStablePrefix(&result, 2, &committed));
+  EXPECT_EQ(committed.tokens, (std::vector<int64_t>{10, 11}));
+  EXPECT_EQ(committed.timestamps, (std::vector<int32_t>{2, 4}));
+  EXPECT_EQ(result.hyps.Size(), 2);
+  EXPECT_EQ(result.frame_offset, 100);
+  EXPECT_EQ(result.num_trailing_blanks, 3);
+
+  auto candidates = result.hyps.Vec();
+  ASSERT_EQ(candidates.size(), 2);
+  for (auto &candidate : candidates) {
+    ASSERT_EQ(candidate.ys.size(), 3);
+    EXPECT_EQ(candidate.ys[0], 10);
+    EXPECT_EQ(candidate.ys[1], 11);
+    EXPECT_TRUE(candidate.ys[2] == 20 || candidate.ys[2] == 30);
+    EXPECT_EQ(candidate.timestamps.size(), 1);
+    EXPECT_EQ(candidate.length_normalization_offset, 2);
+    if (candidate.ys[2] == 30) {
+      candidate.log_prob = 20;
+    }
+  }
+
+  Hypotheses continued(std::move(candidates));
+  EXPECT_EQ(continued.GetMostProbable(true).ys.back(), 30);
+}
