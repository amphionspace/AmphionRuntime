From 4f1c3db2a749d8e44cfd9515e84bc50d18e2b4db Mon Sep 17 00:00:00 2001
From: Boxp <boxp@BoxpdeMacBook-Air.local>
Date: Fri, 4 Sep 2026 16:30:00 +0800
Subject: [PATCH] feat(harmony): decode one online chunk asynchronously

---
 .../sherpa_onnx/src/main/cpp/streaming-asr.cc       | 35 ++++++++++++++++++---
 .../src/main/cpp/types/libsherpa_onnx/Index.d.ts    |  2 ++
 .../src/main/ets/components/StreamingAsr.ets        |  5 ++++
 3 files changed, 36 insertions(+), 6 deletions(-)

diff --git a/harmony-os/SherpaOnnxHar/sherpa_onnx/src/main/cpp/streaming-asr.cc b/harmony-os/SherpaOnnxHar/sherpa_onnx/src/main/cpp/streaming-asr.cc
index 1d80692f..6ebcb04d 100644
--- a/harmony-os/SherpaOnnxHar/sherpa_onnx/src/main/cpp/streaming-asr.cc
+++ b/harmony-os/SherpaOnnxHar/sherpa_onnx/src/main/cpp/streaming-asr.cc
@@ -792,11 +792,13 @@ class DecodeOnlineStreamAsyncWorker : public Napi::AsyncWorker {
       Napi::Env env,
       std::shared_ptr<OnlineRecognizerState> recognizer,
       std::shared_ptr<OnlineStreamState> stream,
-      Napi::Promise::Deferred deferred)
+      Napi::Promise::Deferred deferred,
+      bool decode_all)
       : Napi::AsyncWorker(env, "DecodeOnlineStreamAsyncWorker"),
         recognizer_(std::move(recognizer)),
         stream_(std::move(stream)),
-        deferred_(deferred) {}
+        deferred_(deferred),
+        decode_all_(decode_all) {}
 
   void Execute() override {
     try {
@@ -809,8 +811,16 @@ class DecodeOnlineStreamAsyncWorker : public Napi::AsyncWorker {
         return;
       }
       const auto started = std::chrono::steady_clock::now();
-      while (SherpaOnnxIsOnlineStreamReady(recognizer, stream)) {
+      if (!decode_all_) {
+        if (!SherpaOnnxIsOnlineStreamReady(recognizer, stream)) {
+          error_ = "Online stream is not ready for a single decode";
+          return;
+        }
         SherpaOnnxDecodeOnlineStream(recognizer, stream);
+      } else {
+        while (SherpaOnnxIsOnlineStreamReady(recognizer, stream)) {
+          SherpaOnnxDecodeOnlineStream(recognizer, stream);
+        }
       }
       duration_ms_ = std::chrono::duration_cast<std::chrono::milliseconds>(
           std::chrono::steady_clock::now() - started).count();
@@ -843,10 +853,11 @@ class DecodeOnlineStreamAsyncWorker : public Napi::AsyncWorker {
   Napi::Promise::Deferred deferred_;
   int64_t duration_ms_ = 0;
   std::string error_;
+  bool decode_all_ = true;
 };
 
-static Napi::Value DecodeOnlineStreamAsyncWrapper(
-    const Napi::CallbackInfo &info) {
+static Napi::Value StartDecodeOnlineStreamAsync(
+    const Napi::CallbackInfo &info, bool decode_all) {
   Napi::Env env = info.Env();
   if (info.Length() != 2 || !info[0].IsExternal() ||
       !info[1].IsExternal()) {
@@ -872,7 +883,7 @@ static Napi::Value DecodeOnlineStreamAsyncWrapper(
 
   Napi::Promise::Deferred deferred = Napi::Promise::Deferred::New(env);
   auto *worker = new DecodeOnlineStreamAsyncWorker(
-      env, std::move(recognizer), std::move(stream), deferred);
+      env, std::move(recognizer), std::move(stream), deferred, decode_all);
   try {
     worker->Queue();
   } catch (...) {
@@ -882,6 +893,16 @@ static Napi::Value DecodeOnlineStreamAsyncWrapper(
   return deferred.Promise();
 }
 
+static Napi::Value DecodeOnlineStreamAsyncWrapper(
+    const Napi::CallbackInfo &info) {
+  return StartDecodeOnlineStreamAsync(info, true);
+}
+
+static Napi::Value DecodeOneOnlineStreamAsyncWrapper(
+    const Napi::CallbackInfo &info) {
+  return StartDecodeOnlineStreamAsync(info, false);
+}
+
 static Napi::String GetOnlineStreamResultAsJsonWrapper(
     const Napi::CallbackInfo &info) {
   Napi::Env env = info.Env();
@@ -1176,6 +1197,8 @@ void InitStreamingAsr(Napi::Env env, Napi::Object exports) {
               Napi::Function::New(env, DecodeOnlineStreamWrapper));
   exports.Set(Napi::String::New(env, "decodeOnlineStreamAsync"),
               Napi::Function::New(env, DecodeOnlineStreamAsyncWrapper));
+  exports.Set(Napi::String::New(env, "decodeOneOnlineStreamAsync"),
+              Napi::Function::New(env, DecodeOneOnlineStreamAsyncWrapper));
 
   exports.Set(Napi::String::New(env, "getOnlineStreamResultAsJson"),
               Napi::Function::New(env, GetOnlineStreamResultAsJsonWrapper));
diff --git a/harmony-os/SherpaOnnxHar/sherpa_onnx/src/main/cpp/types/libsherpa_onnx/Index.d.ts b/harmony-os/SherpaOnnxHar/sherpa_onnx/src/main/cpp/types/libsherpa_onnx/Index.d.ts
index 21f2a5d0..c2e5505b 100644
--- a/harmony-os/SherpaOnnxHar/sherpa_onnx/src/main/cpp/types/libsherpa_onnx/Index.d.ts
+++ b/harmony-os/SherpaOnnxHar/sherpa_onnx/src/main/cpp/types/libsherpa_onnx/Index.d.ts
@@ -40,6 +40,8 @@ export const isOnlineStreamReady: (handle: object, streamHandle: object) => bool
 export const decodeOnlineStream: (handle: object, streamHandle: object) => void;
 export const decodeOnlineStreamAsync: (handle: object,
   streamHandle: object) => Promise<number>;
+export const decodeOneOnlineStreamAsync: (handle: object,
+  streamHandle: object) => Promise<number>;
 export const isEndpoint: (handle: object, streamHandle: object) => boolean;
 export const getEndpointReason: (handle: object, streamHandle: object) => number;
 export const commitRule3Segment: (handle: object, streamHandle: object) => boolean;
diff --git a/harmony-os/SherpaOnnxHar/sherpa_onnx/src/main/ets/components/StreamingAsr.ets b/harmony-os/SherpaOnnxHar/sherpa_onnx/src/main/ets/components/StreamingAsr.ets
index 4037d0f9..c5f27afb 100644
--- a/harmony-os/SherpaOnnxHar/sherpa_onnx/src/main/ets/components/StreamingAsr.ets
+++ b/harmony-os/SherpaOnnxHar/sherpa_onnx/src/main/ets/components/StreamingAsr.ets
@@ -8,6 +8,7 @@ import {
   commitStablePrefix,
   decodeOnlineStream,
   decodeOnlineStreamAsync,
+  decodeOneOnlineStreamAsync,
   destroyOnlineStream,
   getOnlineStreamResultAsJson,
   getEndpointReason,
@@ -184,6 +185,10 @@ export class OnlineRecognizer {
     return decodeOnlineStreamAsync(this.handle, stream.handle);
   }
 
+  decodeOneAsync(stream: OnlineStream): Promise<number> {
+    return decodeOneOnlineStreamAsync(this.handle, stream.handle);
+  }
+
   isEndpoint(stream: OnlineStream): boolean {
     return isEndpoint(this.handle, stream.handle);
   }
-- 
2.50.1 (Apple Git-155)
