 static void DestroyOnlineRecognizerWrapper(const Napi::CallbackInfo &info) {
@@ -772,6 +782,102 @@ static void DecodeOnlineStreamWrapper(const Napi::CallbackInfo &info) {
   SherpaOnnxDecodeOnlineStream(recognizer, stream);
 }
 
+class DecodeOnlineStreamAsyncWorker : public Napi::AsyncWorker {
+ public:
+  DecodeOnlineStreamAsyncWorker(
+      Napi::Env env,
+      std::shared_ptr<OnlineRecognizerState> recognizer,
+      std::shared_ptr<OnlineStreamState> stream,
+      Napi::Promise::Deferred deferred)
+      : Napi::AsyncWorker(env, "DecodeOnlineStreamAsyncWorker"),
+        recognizer_(std::move(recognizer)),
+        stream_(std::move(stream)),
+        deferred_(deferred) {}
+
+  void Execute() override {
+    try {
+      const SherpaOnnxOnlineRecognizer *recognizer =
+          recognizer_ == nullptr ? nullptr : recognizer_->Get();
+      const SherpaOnnxOnlineStream *stream =
+          stream_ == nullptr ? nullptr : stream_->Get();
+      if (recognizer == nullptr || stream == nullptr) {
+        error_ = "Online recognizer or stream is closed";
+        return;
+      }
+      const auto started = std::chrono::steady_clock::now();
+      while (SherpaOnnxIsOnlineStreamReady(recognizer, stream)) {
+        SherpaOnnxDecodeOnlineStream(recognizer, stream);
+      }
+      duration_ms_ = std::chrono::duration_cast<std::chrono::milliseconds>(
+          std::chrono::steady_clock::now() - started).count();
+    } catch (const std::exception &e) {
+      error_ = e.what();
+    } catch (...) {
+      error_ = "Unknown native exception while decoding online stream";
+    }
+    // Release native leases on the worker thread. If cancel/unload already
+    // closed the JS handles, native destruction also stays off the UI thread.
+    stream_.reset();
+    recognizer_.reset();
+  }
+
+  void OnOK() override {
+    if (!error_.empty()) {
+      deferred_.Reject(Napi::Error::New(Env(), error_).Value());
+      return;
+    }
+    deferred_.Resolve(Napi::Number::New(Env(), duration_ms_));
+  }
+
+  void OnError(const Napi::Error &error) override {
+    deferred_.Reject(error.Value());
+  }
+
+ private:
+  std::shared_ptr<OnlineRecognizerState> recognizer_;
+  std::shared_ptr<OnlineStreamState> stream_;
+  Napi::Promise::Deferred deferred_;
+  int64_t duration_ms_ = 0;
+  std::string error_;
+};
+
+static Napi::Value DecodeOnlineStreamAsyncWrapper(
+    const Napi::CallbackInfo &info) {
+  Napi::Env env = info.Env();
+  if (info.Length() != 2 || !info[0].IsExternal() ||
+      !info[1].IsExternal()) {
+    Napi::TypeError::New(
+        env, "Expected online recognizer and stream handles")
+        .ThrowAsJavaScriptException();
+    return env.Null();
+  }
+
+  OnlineRecognizerHandle *recognizer_handle =
+      GetOnlineRecognizerHandle(info, 0);
+  OnlineStreamHandle *stream_handle = GetOnlineStreamHandle(info, 1);
+  std::shared_ptr<OnlineRecognizerState> recognizer =
+      recognizer_handle == nullptr ? nullptr : recognizer_handle->Lease();
+  std::shared_ptr<OnlineStreamState> stream =
+      stream_handle == nullptr ? nullptr : stream_handle->Lease();
+  if (recognizer == nullptr || recognizer->Get() == nullptr ||
+      stream == nullptr || stream->Get() == nullptr) {
+    Napi::Error::New(env, "Online recognizer or stream is closed")
+        .ThrowAsJavaScriptException();
+    return env.Null();
+  }
+
+  Napi::Promise::Deferred deferred = Napi::Promise::Deferred::New(env);
+  auto *worker = new DecodeOnlineStreamAsyncWorker(
+      env, std::move(recognizer), std::move(stream), deferred);
+  try {
+    worker->Queue();
+  } catch (...) {
+    delete worker;
+    throw;
+  }
+  return deferred.Promise();
+}
+
 static Napi::String GetOnlineStreamResultAsJsonWrapper(
     const Napi::CallbackInfo &info) {
   Napi::Env env = info.Env();
@@ -1008,6 +1114,8 @@ void InitStreamingAsr(Napi::Env env, Napi::Object exports) {
 
   exports.Set(Napi::String::New(env, "decodeOnlineStream"),
               Napi::Function::New(env, DecodeOnlineStreamWrapper));
+  exports.Set(Napi::String::New(env, "decodeOnlineStreamAsync"),
+              Napi::Function::New(env, DecodeOnlineStreamAsyncWrapper));
 
   exports.Set(Napi::String::New(env, "getOnlineStreamResultAsJson"),
               Napi::Function::New(env, GetOnlineStreamResultAsJsonWrapper));
