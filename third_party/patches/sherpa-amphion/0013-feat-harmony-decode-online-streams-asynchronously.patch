   static int64_t ActiveCount() { return LiveCount().load(); }
 
  private:
@@ -35,11 +38,37 @@ class OnlineStreamHandle {
   }
 
   const SherpaOnnxOnlineStream *stream_;
+  std::shared_ptr<OnlineRecognizerState> recognizer_;
+};
+
+class OnlineStreamHandle {
+ public:
+  explicit OnlineStreamHandle(
+      const SherpaOnnxOnlineStream *stream,
+      std::shared_ptr<OnlineRecognizerState> recognizer = nullptr)
+      : state_(std::make_shared<OnlineStreamState>(stream,
+                                                   std::move(recognizer))) {}
+
+  const SherpaOnnxOnlineStream *Get() const {
+    return state_ == nullptr ? nullptr : state_->Get();
+  }
+
+  std::shared_ptr<OnlineStreamState> Lease() const { return state_; }
+
+  void Close() {
+    state_.reset();
+  }
+
+  static int64_t ActiveCount() { return OnlineStreamState::ActiveCount(); }
+
+ private:
+  std::shared_ptr<OnlineStreamState> state_;
 };
 
 inline Napi::External<OnlineStreamHandle> WrapOnlineStream(
-    Napi::Env env, const SherpaOnnxOnlineStream *stream) {
-  auto *handle = new OnlineStreamHandle(stream);
+    Napi::Env env, const SherpaOnnxOnlineStream *stream,
+    std::shared_ptr<OnlineRecognizerState> recognizer = nullptr) {
+  auto *handle = new OnlineStreamHandle(stream, std::move(recognizer));
   return Napi::External<OnlineStreamHandle>::New(
       env, handle, [](Napi::Env, OnlineStreamHandle *value) { delete value; });
 }
