-/* Number of iterations in spin-wait loop before going into futex/condvar wait */
-#define PTHREADPOOL_SPIN_WAIT_ITERATIONS 1000000
+/* Number of iterations in spin-wait loop before going into futex/condvar wait.
+ *
+ * Upstream yields a million times before blocking, on the workers and on the
+ * dispatching thread. The role encoder runs one 10 s window per second, so the
+ * pool is idle between windows and every worker burns that loop when an
+ * inference ends. Measured on VYG-AL30, four encoder threads cost 0.73
+ * CPU-seconds per wall second more than one thread while the encoder took the
+ * same wall time (408 vs 429 ms). Keep a bounded spin that still covers
+ * back-to-back operator dispatch inside one inference; the futex fallback then
+ * costs one syscall per parallel section.
+ */
+#define PTHREADPOOL_SPIN_WAIT_ITERATIONS 4096
 
 #define PTHREADPOOL_CACHELINE_SIZE 64
