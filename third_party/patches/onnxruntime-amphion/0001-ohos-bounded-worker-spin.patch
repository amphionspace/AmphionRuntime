 using namespace xnnpack;
 
+// Temporary read-only diagnostic; no allocator operation is changed.
+static void TraceXnnpackArena(const char* phase) {
+  const auto& [allocator, ignored] = GetStoredAllocator();
+  if (!allocator) return;
+  AllocatorStats stats{};
+  allocator->GetStats(&stats);
+  long pages = 0, resident = 0;
+  std::ifstream("/proc/self/statm") >> pages >> resident;
+  FILE* file = std::fopen("/data/storage/el2/base/haps/amphion_asr_demo/files/community-arena-reclaim.ndjson", "a");
+  if (!file) return;
+  auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+    std::chrono::system_clock::now().time_since_epoch()).count();
+  std::fprintf(file, "{\"phase\":\"%s\",\"wallTimeMs\":%lld,\"rss\":%ld,\"live\":%lld,\"peakLive\":%lld,\"reserved\":%lld,\"allocations\":%lld,\"extensions\":%lld,\"shrinks\":%lld}\n",
+    phase, static_cast<long long>(ms), resident * sysconf(_SC_PAGESIZE),
+    static_cast<long long>(stats.bytes_in_use), static_cast<long long>(stats.max_bytes_in_use),
+    static_cast<long long>(stats.total_allocated_bytes), static_cast<long long>(stats.num_allocs),
+    static_cast<long long>(stats.num_arena_extensions), static_cast<long long>(stats.num_arena_shrinkages));
+  std::fclose(file);
+}
+
+common::Status XnnpackExecutionProvider::OnRunStart() {
+  TraceXnnpackArena("run-start");
+  return Status::OK();
+}
+common::Status XnnpackExecutionProvider::OnRunEnd(bool) {
+  TraceXnnpackArena("run-end");
+  return Status::OK();
+}
