   if (st != xnn_status_success) {
     ORT_THROW("XNNPACK initialization failed with status ", st);
   }
+  TraceXnnpackArena("allocator-created");
   return std::vector<AllocatorPtr>{stored_allocator};
 }
 
@@ -322,8 +358,22 @@ std::shared_ptr<KernelRegistry> XnnpackExecutionProvider::GetKernelRegistry() co
 }
 
 XnnpackExecutionProvider::~XnnpackExecutionProvider() {
+  TraceXnnpackArena("provider-destroy");
   xnn_deinitialize();
   pthreadpool_destroy(xnnpack_thread_pool_);
+  // The XNNPACK allocator outlives every session. Release its empty regions
+  // after the last kernel owner is gone, instead of retaining graph workspace
+  // until process exit. Other sessions' live allocations must remain intact.
+  const auto& [allocator, ignored] = GetStoredAllocator();
+  if (allocator && allocator->Info().alloc_type == OrtArenaAllocator) {
+    AllocatorStats stats{};
+    allocator->GetStats(&stats);
+    if (stats.bytes_in_use == 0) {
+      auto status = static_cast<BFCArena*>(allocator.get())->Shrink();
+      if (!status.IsOK()) LOGS_DEFAULT(WARNING) << "XNNPACK idle arena release failed: " << status.ErrorMessage();
+    }
+  }
+  TraceXnnpackArena("provider-reclaimed");
 }
 
