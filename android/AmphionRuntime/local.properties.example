## 复制为 local.properties（已在 .gitignore，勿提交）
sdk.dir=/Users/<you>/Library/Android/sdk

# 鼎桥 Demo release 签名（keystore 在 keystore/ 目录，已被 .gitignore）
dingqiaoReleaseStoreFile=keystore/dingqiao-demo-release.jks
dingqiaoReleaseStorePassword=<your-store-password>
dingqiaoReleaseKeyAlias=dingqiao-demo
dingqiaoReleaseKeyPassword=<your-key-password>
