<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.AmphionAsrSample" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_accent</item>
        <item name="colorPrimaryDark">@color/brand_accent_pressed</item>
        <item name="colorAccent">@color/brand_accent</item>

        <item name="colorControlNormal">@color/brand_text_muted</item>
        <item name="colorControlActivated">@color/brand_accent</item>
        <item name="colorControlHighlight">@color/brand_accent_pressed</item>

        <item name="android:windowBackground">@color/brand_cream</item>
        <item name="android:statusBarColor">@color/brand_cream</item>
        <item name="android:navigationBarColor">@color/brand_cream</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <item name="android:textColorPrimary">@color/brand_text_primary</item>
        <item name="android:textColorSecondary">@color/brand_text_secondary</item>
        <item name="android:textColorTertiary">@color/brand_text_muted</item>
    </style>

    <style name="TextAppearance.Amphion.BrandTitle" parent="TextAppearance.AppCompat">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/brand_text_primary</item>
        <item name="android:letterSpacing">0.16</item>
    </style>

    <style name="TextAppearance.Amphion.BrandSubtitle" parent="TextAppearance.AppCompat">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/brand_text_muted</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TextAppearance.Amphion.CardLabel" parent="TextAppearance.AppCompat">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/brand_text_muted</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.Amphion.Body" parent="TextAppearance.AppCompat">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/brand_text_primary</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="TextAppearance.Amphion.Status" parent="TextAppearance.AppCompat">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/brand_text_secondary</item>
    </style>

</resources>
