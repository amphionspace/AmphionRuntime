<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/brand_cream"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_root"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="@dimen/screen_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

    <LinearLayout
        android:id="@+id/brand_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="@dimen/logo_size"
            android:layout_height="@dimen/logo_size"
            android:contentDescription="@string/brand_title"
            android:src="@drawable/ic_amphion_logo" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_title"
                android:textAppearance="@style/TextAppearance.Amphion.BrandTitle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/brand_subtitle"
                android:textAppearance="@style/TextAppearance.Amphion.BrandSubtitle" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/lang_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_segment_container"
        android:orientation="vertical"
        android:padding="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/brand_header">

        <RadioGroup
            android:id="@+id/rg_lang"
            android:layout_width="match_parent"
            android:layout_height="@dimen/segment_height"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_zh_en"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_segment_selector"
                android:button="@null"
                android:gravity="center"
                android:text="@string/lang_zh_en"
                android:textColor="@color/segment_text_selector"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rb_yue_en"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_segment_selector"
                android:button="@null"
                android:gravity="center"
                android:text="@string/lang_yue_en"
                android:textColor="@color/segment_text_selector"
                android:textSize="14sp"
                android:textStyle="bold" />

        </RadioGroup>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/status_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lang_card">

        <View
            android:id="@+id/status_dot"
            android:layout_width="@dimen/status_dot_size"
            android:layout_height="@dimen/status_dot_size"
            android:layout_marginEnd="8dp"
            android:background="@drawable/status_dot" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/status_idle"
            android:textAppearance="@style/TextAppearance.Amphion.Status" />

        <TextView
            android:id="@+id/tv_loading_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/loading_model_short"
            android:textColor="@color/brand_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:indeterminateTint="@color/brand_accent"
        android:progressTint="@color/brand_accent"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/status_row"
        tools:visibility="visible" />

    <com.amphion.asr.sample.WaveformView
        android:id="@+id/waveform"
        android:layout_width="0dp"
        android:layout_height="@dimen/waveform_height"
        android:layout_marginTop="@dimen/card_spacing"
        android:background="@drawable/bg_card"
        android:paddingStart="@dimen/card_padding"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/card_padding"
        android:paddingBottom="10dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progress"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/card_partial"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/card_spacing"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="@dimen/card_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/waveform">

        <TextView
            android:id="@+id/tv_partial_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_partial"
            android:textAppearance="@style/TextAppearance.Amphion.CardLabel" />

        <TextView
            android:id="@+id/tv_partial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/partial_placeholder"
            android:minHeight="56dp"
            android:textAppearance="@style/TextAppearance.Amphion.Body"
            android:textColorHint="@color/brand_text_muted"
            tools:text="正在识别 Amphion runtime…" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/card_final"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/card_spacing"
        android:layout_marginBottom="@dimen/card_spacing"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="@dimen/card_padding"
        app:layout_constraintBottom_toTopOf="@id/btn_talk"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_partial">

        <TextView
            android:id="@+id/tv_final_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_final"
            android:textAppearance="@style/TextAppearance.Amphion.CardLabel" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/tv_final"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/final_placeholder"
                android:textAppearance="@style/TextAppearance.Amphion.Body"
                android:textColorHint="@color/brand_text_muted" />

        </ScrollView>

        <TextView
            android:id="@+id/tv_metrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:text="@string/metrics_placeholder"
            android:textColor="@color/brand_text_muted"
            android:textSize="11sp"
            tools:text="E2E 145 ms · 首字 90 ms · RTF 0.18 · RSS 167 MB" />

    </LinearLayout>

    <Button
        android:id="@+id/btn_talk"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height"
        android:background="@drawable/bg_button_primary"
        android:drawableStart="@drawable/ic_mic"
        android:drawablePadding="12dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:stateListAnimator="@null"
        android:text="@string/btn_talk_start"
        android:textColor="@color/brand_on_accent"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
