# git-format-patch context lines intentionally contain one leading space.
third_party/patches/**/*.patch whitespace=-blank-at-eol,-blank-at-eof

# Paddle LAC vendor dictionaries use trailing tabs as field separators. Keep the
# files byte-identical to the HarmonyOS assets and exclude only this asset scope
# from Git's source-code whitespace checks.
asr/android/sdk-police/src/main/assets/lac/v1/*.dic -whitespace
